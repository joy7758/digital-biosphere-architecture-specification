    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-40-CLEAN-CLONE-VERIFICATION-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_PLAN_NOT_AUTHORIZED_NOT_EXECUTED"},
    "repository": {"const": "https://github.com/joy7758/titmas-integrations.git"},
    "branch": {"const": "codex/rb0-governance-baseline"},
    "commit": {"const": "9610748d4a72d81278df2bc296518a469ce2fd30"},
    "expected_inventory_reference": {"const": "pre40-expected-repository-inventory.v0.1.json"},
    "clone_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_isolated_directory_required",
        "single_branch_required",
        "exact_commit_required",
        "existing_target_worktree_may_be_used_as_verification_source",
        "provider_api_requests_max",
        "model_requests_max",
        "credential_reads_max"
      ],
      "properties": {
        "fresh_isolated_directory_required": {"const": true},
        "single_branch_required": {"const": true},
        "exact_commit_required": {"const": true},
        "existing_target_worktree_may_be_used_as_verification_source": {"const": false},
        "provider_api_requests_max": {"const": 0},
        "model_requests_max": {"const": 0},
        "credential_reads_max": {"const": 0}
