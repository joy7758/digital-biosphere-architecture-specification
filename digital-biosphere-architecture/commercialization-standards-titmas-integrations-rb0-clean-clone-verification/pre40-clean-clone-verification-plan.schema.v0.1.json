{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre40-clean-clone-verification-plan.schema.v0.1.json",
  "title": "PRE-40 Clean-clone Verification Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
