    "pass_outcome": {"const": "DEVELOPMENT_RB0_CLEAN_CLONE_VERIFICATION_PASS_ADOPTION_REVIEW_READY_NOT_ADOPTED"},
    "fail_outcome": {"const": "FAIL_CLOSED_RB0_ADOPTION_REVIEW_NOT_READY"},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_repository_modification_authorized",
        "repository_baseline_adoption_authorized",
        "implementation_authorized",
        "provider_supported",
        "conformance_executed",
        "merge_authorized",
        "pull_request_authorized",
        "release_authorized"
      ],
      "properties": {
        "target_repository_modification_authorized": {"const": false},
        "repository_baseline_adoption_authorized": {"const": false},
        "implementation_authorized": {"const": false},
        "provider_supported": {"const": false},
        "conformance_executed": {"const": false},
        "merge_authorized": {"const": false},
        "pull_request_authorized": {"const": false},
        "release_authorized": {"const": false}
      }
