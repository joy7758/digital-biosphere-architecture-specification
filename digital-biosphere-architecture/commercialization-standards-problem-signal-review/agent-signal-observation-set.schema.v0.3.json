{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:agent-native-problem-signal-observation-set:0.3",
  "title": "TITMAS Agent-native Problem Signal Observation Set v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "validation_id",
    "artifact_class",
    "plan_reference",
    "decision_reference",
    "executed_at",
    "raw_provider_envelopes_persisted",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-signal-observation-set.schema.v0.3.json"
    },
    "schema_version": {
      "const": "0.3"
    },
    "validation_id": {
      "const": "TITMAS-VEAP-APS-20260726-003"
    },
    "artifact_class": {
      "const": "SANITIZED_AGENT_NATIVE_PROBLEM_SIGNAL_OBSERVATIONS"
    },
    "plan_reference": {
      "const": "validation-plan.v0.3.json"
    },
    "decision_reference": {
      "const": "CS-D02-PRE-05"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_provider_envelopes_persisted": {
      "const": false
    },
    "sessions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "provider_gateway",
          "endpoint_host",
          "model",
          "reviewer_role",
          "started_at",
          "completed_at",
          "attempts",
          "request_sha256",
          "http_status",
          "transport_status",
          "provider_body_sha256",
          "provider_body_bytes",
          "content_sha256",
          "content_bytes",
          "parse_status",
          "failure_category",
          "usage",
          "result"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_gateway": {
            "enum": [
              "qianfan",
              "ark",
              "deepseek"
            ]
          },
          "endpoint_host": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_role": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "transport_status": {
            "enum": [
              "SUCCESS",
              "PROVIDER_RESPONSE_FAILURE",
              "TRANSPORT_FAILURE"
            ]
          },
          "provider_body_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "provider_body_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parse_status": {
            "enum": [
              "PARSED_JSON",
              "INVALID_JSON_RETAINED_NO_REPAIR",
              "NOT_PARSED"
            ]
          },
          "failure_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "./agent-signal-response.schema.v0.2.json"
              }
            ]
          }
        }
      }
    }
  }
}
