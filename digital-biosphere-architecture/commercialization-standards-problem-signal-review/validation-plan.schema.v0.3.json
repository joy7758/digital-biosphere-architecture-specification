          "properties": {
            "validation_id": {
              "const": "TITMAS-VEAP-APS-20260726-002"
            },
            "result": {
              "const": "PASS_TECHNICAL_THRESHOLDS_OUT_OF_SCOPE_NO_GATE_EFFECT"
