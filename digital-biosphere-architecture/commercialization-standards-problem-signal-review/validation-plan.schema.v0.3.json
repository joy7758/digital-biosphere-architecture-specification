            },
            "result": {
              "const": "FAIL_REMEDIATION_REQUIRED"
            },
            "result_reference": {
              "const": "scored-result.v0.1.json"
            },
            "gate_effect": {
              "const": false
            },
            "history_retained": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validation_id",
            "result",
            "result_reference",
            "gate_effect",
            "history_retained"
