      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "provider_gateway",
          "endpoint_host",
          "model",
          "reviewer_role",
          "role_focus",
          "thinking_mode"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 4
          },
          "provider_gateway": {
            "enum": [
              "qianfan",
              "ark",
              "deepseek"
            ]
          },
          "endpoint_host": {
            "type": "string",
            "minLength": 4
          },
          "model": {
            "type": "string",
            "minLength": 3
          },
          "reviewer_role": {
            "enum": [
              "DISCOVERY_AND_RETRIEVAL_REVIEWER",
              "CODING_AND_INTEGRATION_REVIEWER",
              "RECOMMENDATION_REVIEWER",
              "METHOD_REVIEWER",
              "SECURITY_AND_CLAIM_REVIEWER",
              "ARCHITECTURE_BOUNDARY_REVIEWER"
            ]
          },
          "role_focus": {
            "type": "string",
            "minLength": 20
          },
          "thinking_mode": {
            "enum": [
              "PROVIDER_DEFAULT",
              "DISABLED"
            ]
          }
        }
      }
    },
