{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/public-source-record-review-validation-plan.schema.v0.1.json",
  "title": "TITMAS PRE-10 Public Source Record Review Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "decision_record_reference",
    "source_candidate_set_reference",
    "source_candidate_set_sha256",
    "source_pack_reference",
    "source_pack_sha256",
    "prompt_template_reference",
    "prompt_template_sha256",
    "response_schema_reference",
    "response_schema_sha256",
    "sessions",
    "thresholds",
    "controls",
    "execution_gate",
    "non_effects"
  ],
  "properties": {
    "$schema": {"const": "./validation-plan.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-10-PUBLIC-SOURCE-RECORD-REVIEW-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_AUTHORIZATION_BASELINE_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-10"},
    "decision_record_reference": {"const": "../TITMAS-CS-D02-PRE-10-PUBLIC-FIRST-PARTY-CANDIDATE-REVIEW-DECISION-RECORD.v0.1.json"},
    "source_candidate_set_reference": {"const": "../commercialization-standards-public-source-problem-validation/source-candidate-set.v0.1.json"},
    "source_candidate_set_sha256": {"const": "f7253e3e2545b1200f1a7eb27b9ce5d323e1eb090b2c1178e112707983ba6300"},
    "source_pack_reference": {"const": "source-pack.v0.1.md"},
    "source_pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_template_reference": {"const": "prompt-template.v0.1.txt"},
    "prompt_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "response_schema_reference": {"const": "agent-record-review-response.schema.v0.1.json"},
    "response_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sessions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "provider_gateway",
          "endpoint_host",
          "model",
          "reviewer_role",
          "requests_max"
        ],
        "properties": {
          "session_id": {"type": "string", "minLength": 8},
          "provider_gateway": {"enum": ["qianfan", "deepseek"]},
          "endpoint_host": {"enum": ["qianfan.baidubce.com", "api.deepseek.com"]},
          "model": {"enum": ["kimi-k2.6", "deepseek-chat"]},
          "reviewer_role": {
            "enum": [
              "SOURCE_QUALIFICATION_REVIEWER",
              "ACCOUNTABILITY_RELEVANCE_REVIEWER",
              "CLAIM_AND_PRIVACY_REVIEWER",
              "ADVERSARIAL_RECORD_REVIEWER"
            ]
          },
          "requests_max": {"const": 1}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parseable_sessions_min",
        "providers_with_success_min",
        "candidate_ids_covered_min",
        "boundary_failures_max"
      ],
      "properties": {
        "parseable_sessions_min": {"const": 3},
        "providers_with_success_min": {"const": 2},
        "candidate_ids_covered_min": {"const": 4},
        "boundary_failures_max": {"const": 0}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools_allowed",
        "fallback_model_allowed",
        "json_repair_allowed",
        "raw_provider_envelope_persisted",
        "secret_in_request_allowed",
        "customer_or_personal_data_allowed",
        "direct_personal_identifiers_allowed",
        "new_source_search_allowed",
        "new_source_collection_allowed",
        "automatic_valid_status_allowed",
        "automatic_counting_allowed"
      ],
      "properties": {
        "tools_allowed": {"const": false},
        "fallback_model_allowed": {"const": false},
        "json_repair_allowed": {"const": false},
        "raw_provider_envelope_persisted": {"const": false},
        "secret_in_request_allowed": {"const": false},
        "customer_or_personal_data_allowed": {"const": false},
        "direct_personal_identifiers_allowed": {"const": false},
        "new_source_search_allowed": {"const": false},
        "new_source_collection_allowed": {"const": false},
        "automatic_valid_status_allowed": {"const": false},
        "automatic_counting_allowed": {"const": false}
      }
    },
    "execution_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_baseline_committed",
        "authorization_baseline_pushed",
        "execution_started"
      ],
      "properties": {
        "authorization_baseline_committed": {"const": false},
        "authorization_baseline_pushed": {"const": false},
        "execution_started": {"const": false}
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_problem_records",
        "cs_g0_pass",
        "market_validation_pass",
        "customer_adoption",
        "implementation_authorized",
        "commercial_offer_authorized",
        "certification_authorized",
        "release_authorized"
      ],
      "properties": {
        "valid_problem_records": {"const": 0},
        "cs_g0_pass": {"const": false},
        "market_validation_pass": {"const": false},
        "customer_adoption": {"const": false},
        "implementation_authorized": {"const": false},
        "commercial_offer_authorized": {"const": false},
        "certification_authorized": {"const": false},
        "release_authorized": {"const": false}
      }
    }
  }
}
