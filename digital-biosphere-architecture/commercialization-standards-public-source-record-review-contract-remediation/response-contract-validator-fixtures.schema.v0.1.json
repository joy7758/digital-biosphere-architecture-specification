{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:cs-d02-pre-13-response-contract-validator-fixtures:0.1",
  "title": "TITMAS PRE-13 Response Contract Validator Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "observed_on",
    "decision_reference",
    "target_response_schema_reference",
    "base_payload",
    "cases",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./response-contract-validator-fixtures.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-13-RESPONSE-CONTRACT-VALIDATOR-FIXTURES-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "OFFLINE_SYNTHETIC_VALIDATOR_FIXTURES"},
    "observed_on": {"const": "2026-07-26"},
    "decision_reference": {"const": "CS-D02-PRE-13"},
    "target_response_schema_reference": {"type": "string"},
    "base_payload": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "mutation", "expected_schema_valid"],
        "properties": {
          "fixture_id": {
            "enum": [
              "COMPLIANT_ACCEPTED",
              "MISSING_BOUNDARY_FIELD_REJECTED",
              "COUNTING_EFFECT_TRUE_REJECTED",
              "UNKNOWN_EXTRA_FIELD_REJECTED"
            ]
          },
          "mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "path", "value"],
            "properties": {
              "operation": {"enum": ["NONE", "REMOVE", "REPLACE", "ADD"]},
              "path": {"type": "string"},
              "value": {}
            }
          },
          "expected_schema_valid": {"type": "boolean"}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_only",
        "provider_evidence",
        "candidate_review_completed",
        "live_model_requests_executed"
      ],
      "properties": {
        "synthetic_only": {"const": true},
        "provider_evidence": {"const": false},
        "candidate_review_completed": {"const": false},
        "live_model_requests_executed": {"const": 0}
      }
    }
  }
}
