        "required_before_execution",
        "creates_operational_authority"
      ],
      "properties": {
        "role_id": {
          "enum": [
            "HUMAN_DECISION_OWNER",
            "PROBLEM_VALIDATION_OWNER",
            "PRIVACY_DATA_STEWARD",
            "METHOD_REVIEWER",
            "SECURITY_REVIEWER",
            "CLAIM_REVIEWER"
          ]
        },
        "state": {
          "enum": [
            "ASSIGNED_EXISTING",
            "CANDIDATE_NOT_ACCEPTED",
            "UNASSIGNED_REQUIRED"
          ]
        },
        "candidate_or_owner_ref": {
          "type": "string",
          "minLength": 4
        },
        "acceptance_reference": {
          "type": "string",
          "minLength": 4
        },
