          "enum": [
            "NOT_AUTHORIZED",
            "DESIGN_ONLY_NOT_AUTHORIZED",
            "INTERNAL_ADVISORY_ALLOWED"
          ]
        },
        "cs_g0_counting_eligibility": {
          "type": "string",
          "minLength": 20
        }
      }
