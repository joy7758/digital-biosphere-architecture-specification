      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "current_recommendation",
        "decision_ready",
        "reason"
      ],
      "properties": {
        "id": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 20
        },
        "current_recommendation": {
          "type": "boolean"
        },
        "decision_ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "optionA": {
      "allOf": [
        {
          "$ref": "#/$defs/optionBase"
        },
        {
          "properties": {
            "id": {
              "const": "A"
            },
            "name": {
              "const": "AUTHORIZE_BOUNDED_DIRECT_VALIDATION_EXECUTION"
            },
            "current_recommendation": {
              "const": false
            },
            "decision_ready": {
              "const": false
            }
          }
        }
      ]
    },
    "optionB": {
      "allOf": [
