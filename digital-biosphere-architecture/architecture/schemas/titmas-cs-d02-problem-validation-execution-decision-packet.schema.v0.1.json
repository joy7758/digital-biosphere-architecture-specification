      "properties": {
        "packet_prepared": {
          "const": true
        },
        "decision_ready": {
          "const": false
        },
        "decision_recorded": {
          "const": false
        },
        "current_recommended_option": {
          "const": "C"
        },
        "validation_execution_authorized": {
          "const": false
