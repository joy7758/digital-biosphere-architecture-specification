    },
    "optionC": {
      "allOf": [
        {
          "$ref": "#/$defs/optionBase"
        },
        {
          "properties": {
            "id": {
              "const": "C"
            },
            "name": {
              "const": "CONTINUE_INTERNAL_PREPARATION_AND_FILL_PREREQUISITES"
            },
            "current_recommendation": {
              "const": true
            },
            "decision_ready": {
              "const": true
            }
          }
        }
      ]
    },
    "optionD": {
      "allOf": [
        {
          "$ref": "#/$defs/optionBase"
        },
        {
          "properties": {
            "id": {
              "const": "D"
            },
            "name": {
              "const": "DEFER_OR_STOP_PROBLEM_VALIDATION"
            },
            "current_recommendation": {
              "const": false
            },
            "decision_ready": {
              "const": true
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "state",
        "candidate_or_owner_ref"
      ],
      "properties": {
        "role_id": {
          "enum": [
            "HUMAN_DECISION_OWNER",
            "PROBLEM_VALIDATION_OWNER",
            "PRIVACY_DATA_STEWARD",
            "METHOD_REVIEWER",
            "SECURITY_REVIEWER",
            "CLAIM_REVIEWER"
          ]
        },
        "state": {
          "enum": [
            "ASSIGNED_EXISTING",
            "CANDIDATE_NOT_ACCEPTED",
            "UNASSIGNED_REQUIRED"
          ]
        },
        "candidate_or_owner_ref": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "dataReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_source",
        "validation_channel",
        "storage_reference",
        "access_control_evidence",
        "retention_days",
        "withdrawal_path_reference",
