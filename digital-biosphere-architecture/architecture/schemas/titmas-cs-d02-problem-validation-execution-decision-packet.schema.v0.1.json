{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:cs-d02-problem-validation-execution-decision-packet:0.1",
  "title": "TITMAS CS-D02 VEAP Problem Validation Execution Decision Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "decision_id",
    "status",
    "prepared_at",
    "decision_owner_ref",
    "question",
    "source_references",
    "objective",
    "success_thresholds",
    "options",
    "role_readiness",
    "data_execution_readiness",
    "allowed_data_policy",
    "required_before_option_a_decision",
    "stop_conditions",
    "standing_directive_assessment",
    "current_facts",
    "effects"
  ],
  "properties": {
    "$schema": {
      "const": "./architecture/schemas/titmas-cs-d02-problem-validation-execution-decision-packet.schema.v0.1.json"
    },
    "document_id": {
      "const": "DBA-TITMAS-CS-D02-VEAP-PROBLEM-VALIDATION-EXECUTION-DECISION-PACKET-0.1"
    },
    "version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "const": "CS-D02"
    },
    "status": {
      "const": "PACKET_PREPARED_BLOCKED_INPUT_NOT_DECISION_READY"
    },
    "prepared_at": {
      "type": "string",
      "format": "date"
    },
    "decision_owner_ref": {
      "const": "zhangbin"
    },
    "question": {
      "type": "string",
      "minLength": 80
    },
    "source_references": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "objective": {
      "const": "VALIDATE_REAL_ATTRIBUTABLE_RECENT_HIGH_PRIORITY_AGENT_EXECUTION_ACCOUNTABILITY_PROBLEMS"
    },
    "success_thresholds": {
      "const": {
        "valid_independent_problem_records_min": 5,
        "independent_organization_or_contexts_min": 3,
        "high_priority_records_min": 3,
        "continue_review_interest_min": 2,
        "thresholds_auto_pass_cs_g0": false
      }
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/optionA"
        },
        {
          "$ref": "#/$defs/optionB"
        },
        {
          "$ref": "#/$defs/optionC"
        },
        {
          "$ref": "#/$defs/optionD"
        }
      ],
      "items": false
    },
    "role_readiness": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "HUMAN_DECISION_OWNER"
              },
              "state": {
                "const": "ASSIGNED_EXISTING"
              }
            },
            "required": [
              "role_id",
              "state"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "PROBLEM_VALIDATION_OWNER"
              },
              "state": {
                "const": "CANDIDATE_NOT_ACCEPTED"
              }
            },
            "required": [
              "role_id",
              "state"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role_id": {
                "const": "PRIVACY_DATA_STEWARD"
              },
              "state": {
                "const": "CANDIDATE_NOT_ACCEPTED"
              }
            },
            "required": [
              "role_id",
              "state"
            ]
          }
        }
      ]
    },
    "data_execution_readiness": {
      "$ref": "#/$defs/dataReadiness"
    },
    "allowed_data_policy": {
      "$ref": "#/$defs/dataPolicy"
    },
    "required_before_option_a_decision": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 16
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 16
      }
    },
