    "decision_id": {"const": "CS-D02-PRE-74"},
    "standing_directive_reference": {"const": "TITMAS-CS-STANDING-001"},
    "standing_directive_artifact": {"const": "TITMAS-COMMERCIALIZATION-STANDING-RECOMMENDATION-AUTHORIZATION-v0.1.json"},
    "recommendation_reference": {"const": "TITMAS-CS-D02-PRE-74-OFFLINE-SCHEMA-FAILURE-DIAGNOSTIC-AND-SANITIZED-FAILURE-DETAIL-CAPTURE-RECOMMENDATION-v0.1.md"},
    "recommendation_sha256": {"const": "8d6410abc97271cd1970230774b07876ce19f6c24219b2c35637a200414a810b"},
    "decision_result": {"const": "AUTHORIZE_PRE74_OFFLINE_RESPONSE_CONTRACT_TRANSMISSION_GAP_DIAGNOSTIC_AND_SANITIZED_FAILURE_DETAIL_CAPTURE_DESIGN"},
    "decided_by_ref": {"const": "zhangbin"},
    "decided_at": {"type": "string", "format": "date-time"},
    "executed_by": {"const": "CODEX_AFTER_REMOTE_DECISION_VALIDATION"},
