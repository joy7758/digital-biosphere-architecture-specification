        "input_hashes_required": {"const": "6/6"},
        "synthetic_cases_minimum": {"const": 12},
        "network_requests_max": {"const": 0},
        "live_model_requests_max": {"const": 0},
        "credential_value_reads_max": {"const": 0},
        "raw_provider_response_reads_max": {"const": 0},
        "target_repository_writes_max": {"const": 0},
        "dbos_writes_max": {"const": 0},
        "saee_writes_max": {"const": 0},
        "request_revision_adoptions_max": {"const": 0},
        "response_schema_changes_max": {"const": 0},
        "live_retries_max": {"const": 0}
      }
