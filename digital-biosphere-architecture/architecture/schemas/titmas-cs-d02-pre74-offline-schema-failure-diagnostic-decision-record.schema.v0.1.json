    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_recommendation_present",
        "single_exact_action_present",
        "primary_repository_target_and_scope_explicit",
        "input_hashes_match",
        "scope_schema_pass",
        "coverage_observation_schema_pass",
        "contract_transmission_gap_proven",
        "exact_schema_failure_cause_proven",
        "pre73_live_retry_allowed",
        "standing_directive_active",
        "later_conflicting_human_decision_found"
      ],
      "properties": {
        "canonical_recommendation_present": {"const": true},
        "single_exact_action_present": {"const": true},
        "primary_repository_target_and_scope_explicit": {"const": true},
        "input_hashes_match": {"const": "6/6"},
        "scope_schema_pass": {"const": true},
        "coverage_observation_schema_pass": {"const": true},
        "contract_transmission_gap_proven": {"const": true},
        "exact_schema_failure_cause_proven": {"const": false},
        "pre73_live_retry_allowed": {"const": false},
        "standing_directive_active": {"const": true},
        "later_conflicting_human_decision_found": {"const": false}
