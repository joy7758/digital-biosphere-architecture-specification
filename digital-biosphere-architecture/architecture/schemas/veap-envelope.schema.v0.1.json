{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/veap-envelope.schema.v0.1.json",
  "title": "VEAP Envelope Schema v0.1 Development Candidate",
  "description": "Structural candidate only. Schema validity does not prove semantic conformance, execution correctness, Evidence truth, Permission, Certification, or production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profile_version",
    "attestation_id",
    "issued_at",
    "package_status",
    "subject",
    "execution",
    "context",
    "observation_references",
    "evidence_bindings",
    "verification_bindings",
    "evaluation_bindings",
    "decision_bindings",
    "claims",
    "limitations",
    "revocation"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "namespace", "identifier", "version"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"enum": ["sha256", "sha512"]},
            "value": {"type": "string", "pattern": "^[0-9a-f]+$"}
          },
          "allOf": [
            {
              "if": {"properties": {"algorithm": {"const": "sha256"}}},
              "then": {"properties": {"value": {"pattern": "^[0-9a-f]{64}$"}}}
            },
            {
              "if": {"properties": {"algorithm": {"const": "sha512"}}},
              "then": {"properties": {"value": {"pattern": "^[0-9a-f]{128}$"}}}
            }
          ]
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "$schema": {"type": "string"},
    "profile_version": {"const": "0.1.0-development"},
    "attestation_id": {"type": "string", "pattern": "^veap:[A-Za-z0-9._:-]+$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "package_status": {"enum": ["CURRENT", "PARTIAL", "REVOKED", "NOT_ASSESSED"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_reference", "binding_status"],
      "properties": {
        "entity_reference": {"$ref": "#/$defs/reference"},
        "binding_status": {"enum": ["DBOS_BOUND", "EXTERNAL_ONLY", "NOT_ASSESSED"]},
        "dbos_binding_reference": {"$ref": "#/$defs/reference"}
      },
      "allOf": [
        {
          "if": {"properties": {"binding_status": {"const": "DBOS_BOUND"}}},
          "then": {"required": ["dbos_binding_reference"]}
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "namespace",
        "execution_id",
        "runtime_version",
        "task_reference",
        "started_at",
        "status"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "execution_id": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "task_reference": {"$ref": "#/$defs/reference"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["CREATED", "RUNNING", "SUCCEEDED", "FAILED", "PARTIAL", "UNKNOWN"]},
        "failure_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_references", "tool_references", "policy_references"],
      "properties": {
        "model_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "tool_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "policy_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "observation_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "producer", "schema_version", "delivery_status"],
        "properties": {
          "reference": {"$ref": "#/$defs/reference"},
          "producer": {"$ref": "#/$defs/reference"},
          "schema_version": {"type": "string", "minLength": 1},
          "delivery_status": {"enum": ["COMPLETE", "PARTIAL", "DROPPED", "UNKNOWN"]},
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}
        }
      }
    },
    "evidence_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_reference",
          "admission_reference",
          "canonical_evidence_reference",
          "admission_status",
          "integrity_status",
          "limitations"
        ],
        "properties": {
          "material_reference": {
            "allOf": [
              {"$ref": "#/$defs/reference"},
              {"required": ["digest"]}
            ]
          },
          "admission_reference": {"$ref": "#/$defs/reference"},
          "canonical_evidence_reference": {
            "allOf": [
              {"$ref": "#/$defs/reference"},
              {"required": ["digest"]}
            ]
          },
          "admission_status": {"enum": ["ADMITTED", "REJECTED", "PARTIAL", "UNKNOWN"]},
          "integrity_status": {"enum": ["VERIFIED", "FAILED", "NOT_ASSESSED", "UNKNOWN"]},
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}
        }
      }
    },
    "verification_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_reference",
          "verifier_reference",
          "rule_reference",
          "subject_reference",
          "verification_status",
          "limitations"
        ],
        "properties": {
          "result_reference": {"$ref": "#/$defs/reference"},
          "verifier_reference": {"$ref": "#/$defs/reference"},
          "rule_reference": {"$ref": "#/$defs/reference"},
          "subject_reference": {"$ref": "#/$defs/reference"},
          "verification_status": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_ASSESSED", "UNKNOWN"]},
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}
        }
      }
    },
    "evaluation_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_reference",
          "interface_version",
          "advisory_status",
          "uncertainty",
          "limitations"
        ],
        "properties": {
          "result_reference": {"$ref": "#/$defs/reference"},
          "interface_version": {"type": "string", "minLength": 1},
          "advisory_status": {"const": "ADVISORY_ONLY"},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}
        }
      }
    },
    "decision_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_reference", "issuer_reference", "status", "scope", "valid_until"],
        "properties": {
          "decision_reference": {"$ref": "#/$defs/reference"},
          "issuer_reference": {"$ref": "#/$defs/reference"},
          "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED", "UNKNOWN"]},
          "scope": {"type": "string", "minLength": 1},
          "valid_until": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proves", "does_not_prove"],
      "properties": {
        "proves": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "EXECUTION_HISTORY_REFERENCE",
              "PROVENANCE_BINDING",
              "VERIFICATION_RESULT_REFERENCE"
            ]
          }
        },
        "does_not_prove": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["CORRECTNESS", "TRUTH", "PERMISSION", "CERTIFICATION"]},
          "allOf": [
            {"contains": {"const": "CORRECTNESS"}},
            {"contains": {"const": "TRUTH"}},
            {"contains": {"const": "PERMISSION"}},
            {"contains": {"const": "CERTIFICATION"}}
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/limitation"}
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["CURRENT", "REVOKED", "UNKNOWN"]},
        "reference": {"$ref": "#/$defs/reference"},
        "effective_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "REVOKED"}}},
          "then": {"required": ["reference", "effective_at"]}
        }
      ]
    }
  }
}
