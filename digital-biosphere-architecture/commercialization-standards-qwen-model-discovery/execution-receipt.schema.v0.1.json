{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre56-qwen-model-discovery-execution-receipt.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "completed_at",
    "artifact_count_bound",
    "artifacts",
    "request_counts",
    "effects",
    "next_action"
  ],
  "properties": {
    "$schema": {"const": "./execution-receipt.schema.v0.1.json"},
    "document_id": {
      "const": "TITMAS-CS-D02-PRE-56-QWEN-MODEL-DISCOVERY-EXECUTION-RECEIPT-0.1"
    },
    "version": {"const": "0.1.0"},
    "status": {"const": "PASS_READ_ONLY_MODEL_DISCOVERY"},
    "completed_at": {"type": "string", "format": "date-time"},
    "artifact_count_bound": {"const": 6},
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "request_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "executed",
        "model_inference",
        "retry",
        "fallback",
        "alternate_endpoint",
        "scraping",
        "guessing"
      ],
      "properties": {
        "authorized": {"const": 1},
        "executed": {"const": 1},
        "model_inference": {"const": 0},
        "retry": {"const": 0},
        "fallback": {"const": 0},
        "alternate_endpoint": {"const": 0},
        "scraping": {"const": 0},
        "guessing": {"const": 0}
      }
    },
    "effects": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"const": false}
    },
    "next_action": {
      "const": "FORM_EXACT_QWEN3_7_PLUS_ONBOARDING_BENCHMARK_RECOMMENDATION"
    }
  }
}
