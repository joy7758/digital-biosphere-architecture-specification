        "source_files_created": {"const": 0},
        "package_metadata_files_created": {"const": 0},
        "test_files_created": {"const": 0},
        "network_requests_for_validation": {"const": 0},
        "model_requests": {"const": 0},
        "credential_reads": {"const": 0},
