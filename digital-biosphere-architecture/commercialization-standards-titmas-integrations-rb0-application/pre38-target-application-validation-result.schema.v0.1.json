{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre38-target-application-validation-result.schema.v0.1.json",
  "title": "PRE-38 Target Application Validation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "decision_record_sha256",
    "decision_commit",
    "validated_at",
    "target",
    "validation_attempts",
    "technical_checks",
    "semantic_conflict",
    "effects",
    "next_gate"
  ],
  "properties": {
    "$schema": {"const": "./pre38-target-application-validation-result.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-38-TARGET-APPLICATION-VALIDATION-RESULT-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "REMOTE_BRANCH_PUSHED_SEMANTIC_TRUTH_CONFLICT_FAIL_CLOSED_REMEDIATION_REQUIRED"},
    "decision_reference": {"const": "CS-D02-PRE-38"},
    "decision_record_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "decision_commit": {"const": "16a5282ab5dd551787529116fd02bb83921b5cf9"},
    "validated_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseline_commit",
        "branch",
        "commit",
        "remote_branch_matches_commit",
        "remote_main_commit",
        "remote_main_unchanged",
        "worktree_clean"
      ],
      "properties": {
        "repository": {"const": "https://github.com/joy7758/titmas-integrations.git"},
        "baseline_commit": {"const": "e8eeccbf19e5e1d1f01ab9ad8796a53591a38dc8"},
        "branch": {"const": "codex/rb0-governance-baseline"},
        "commit": {"const": "d54bf17ea94ee614b83253cd6abd8cb51bfdd45b"},
        "remote_branch_matches_commit": {"const": true},
        "remote_main_commit": {"const": "e8eeccbf19e5e1d1f01ab9ad8796a53591a38dc8"},
        "remote_main_unchanged": {"const": true},
        "worktree_clean": {"const": true}
      }
    },
    "validation_attempts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "stage", "result", "failure_code", "mutating_effect"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
          "stage": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL_RETAINED"]},
          "failure_code": {"type": "string", "minLength": 1},
          "mutating_effect": {"const": false}
        }
      }
    },
    "technical_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_paths_exact",
        "target_path_digests_match",
        "schemas_meta_valid",
        "instances_valid",
        "local_schema_references_resolved",
        "secret_or_local_path_findings",
        "source_files_created",
        "package_metadata_files_created",
        "test_files_created",
        "rollback_restore_existing_paths",
        "rollback_remove_new_paths",
        "rollback_dry_run_pass"
      ],
      "properties": {
        "target_paths_exact": {"const": 10},
        "target_path_digests_match": {"const": 10},
        "schemas_meta_valid": {"const": 2},
        "instances_valid": {"const": 2},
        "local_schema_references_resolved": {"const": 2},
        "secret_or_local_path_findings": {"const": 0},
        "source_files_created": {"const": 0},
        "package_metadata_files_created": {"const": 0},
        "test_files_created": {"const": 0},
        "rollback_restore_existing_paths": {"const": 1},
        "rollback_remove_new_paths": {"const": 9},
        "rollback_dry_run_pass": {"const": true}
      }
    },
    "semantic_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "direct_truth_surfaces",
        "schema_correction_required",
        "conflicting_claims",
        "truth_consistent"
      ],
      "properties": {
        "present": {"const": true},
        "direct_truth_surfaces": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "schema_correction_required": {"const": "schemas/titmas-integrations-entry.schema.v0.1.json"},
        "conflicting_claims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1}
        },
        "truth_consistent": {"const": false}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_adoption_decided",
        "license_file_applied_to_target_branch",
        "target_repository_branch_modified",
        "target_branch_pushed",
        "repository_baseline_validated",
        "repository_baseline_adopted",
        "implementation_authorized",
        "implementation_created",
        "provider_supported",
        "conformance_executed",
        "valid_problem_records",
        "cs_g0_pass",
        "commercial_offer_authorized",
        "certification_authorized",
        "merge_authorized",
        "pull_request_authorized",
        "release_authorized"
      ],
      "properties": {
        "license_adoption_decided": {"const": true},
        "license_file_applied_to_target_branch": {"const": true},
        "target_repository_branch_modified": {"const": true},
        "target_branch_pushed": {"const": true},
        "repository_baseline_validated": {"const": false},
        "repository_baseline_adopted": {"const": false},
        "implementation_authorized": {"const": false},
        "implementation_created": {"const": false},
        "provider_supported": {"const": false},
        "conformance_executed": {"const": false},
        "valid_problem_records": {"const": 0},
        "cs_g0_pass": {"const": false},
        "commercial_offer_authorized": {"const": false},
        "certification_authorized": {"const": false},
        "merge_authorized": {"const": false},
        "pull_request_authorized": {"const": false},
        "release_authorized": {"const": false}
      }
    },
    "next_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remediation_required",
        "required_decision",
        "allowed_action_without_new_decision",
        "preserve_pushed_branch_history"
      ],
      "properties": {
        "remediation_required": {"const": true},
        "required_decision": {"const": "CS-D02-PRE-39"},
        "allowed_action_without_new_decision": {"const": "NONE"},
        "preserve_pushed_branch_history": {"const": true}
      }
    }
  }
}
