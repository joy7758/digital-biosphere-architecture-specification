{
  "$schema": "./strict-response-contract-candidate.schema.v0.2.json",
  "contract_version": "titmas.agent-review-response-transport/v0.2",
  "status": "DEVELOPMENT_CANDIDATE_NOT_ADOPTED",
  "purpose": "Define deterministic admission of one model-produced JSON object without extraction or repair.",
  "layers": {
    "provider_transport_envelope": "TRANSPORT_ONLY_NOT_REVIEW_OBJECT",
    "assistant_content": "ONLY_CANDIDATE_REVIEW_OBJECT_SOURCE",
    "review_object": "ADMITTED_ONLY_AFTER_ALL_GATES_PASS"
  },
  "assistant_content_contract": {
    "encoding": "UTF-8",
    "maximum_bytes": 131072,
    "leading_or_trailing_json_whitespace_allowed": true,
    "allowed_json_whitespace_code_points": [
      "U+0020",
      "U+0009",
      "U+000A",
      "U+000D"
    ],
    "top_level_type": "object",
    "single_json_value_required": true,
    "markdown_code_fence_allowed": false,
    "non_whitespace_prefix_allowed": false,
    "non_whitespace_suffix_allowed": false,
    "duplicate_object_keys_allowed": false,
    "maximum_nesting_depth": 16,
    "maximum_total_object_properties": 2048,
    "maximum_array_items": 1024,
    "maximum_string_utf8_bytes": 32768,
    "non_finite_numbers_allowed": false
  },
  "processing_contract": {
    "markdown_fence_stripping_allowed": false,
    "substring_extraction_allowed": false,
    "prefix_or_suffix_discard_allowed": false,
    "json_repair_allowed": false,
    "type_coercion_allowed": false,
    "missing_field_synthesis_allowed": false,
    "unknown_field_deletion_allowed": false,
    "retry_on_contract_failure_allowed": false,
    "fallback_model_on_contract_failure_allowed": false
  },
  "admission_gates": [
    "TRANSPORT_COMPLETED",
    "ASSISTANT_CONTENT_PRESENT",
    "BYTE_LIMIT_PASS",
    "DIRECT_SINGLE_JSON_OBJECT_PASS",
    "DUPLICATE_KEY_REJECTION_PASS",
    "STRUCTURAL_LIMITS_PASS",
    "FROZEN_RESPONSE_SCHEMA_PASS",
    "EXACT_ROLE_MODEL_TARGET_AND_QUESTION_SET_PASS",
    "EXPLICIT_NON_CLAIMS_PASS",
    "SANITIZATION_PASS"
  ],
  "provider_precondition": {
    "provider_native_structured_output_capability_evidence_required": true,
    "prompt_only_json_instruction_sufficient": false,
    "official_documentation_or_bounded_preflight_required": true,
    "endpoint_model_and_request_shape_binding_required": true,
    "unproven_status": "PROVIDER_RESPONSE_CONTRACT_UNPROVEN",
    "unproven_lane_action": "DO_NOT_START_FULL_REVIEW"
  },
  "failure_classes": {
    "code_fence": "FAIL_ASSISTANT_CONTENT_CODE_FENCE",
    "prefix_or_suffix": "FAIL_NON_WHITESPACE_PREFIX_OR_SUFFIX",
    "multiple_values": "FAIL_MULTIPLE_JSON_VALUES",
    "top_level_not_object": "FAIL_TOP_LEVEL_NOT_OBJECT",
    "duplicate_key": "FAIL_DUPLICATE_OBJECT_KEY",
    "size_or_depth": "FAIL_STRUCTURAL_LIMIT",
    "schema": "FAIL_FROZEN_RESPONSE_SCHEMA",
    "role_model_target_or_question_set": "FAIL_EXACT_BINDING",
    "non_claim": "FAIL_EXPLICIT_NON_CLAIM",
    "sanitization": "FAIL_SANITIZATION"
  },
  "truth_boundaries": [
    "OUTER_JSON_NE_DIRECT_ASSISTANT_JSON",
    "DIRECT_JSON_NE_SCHEMA_VALID",
    "SCHEMA_VALID_NE_SECURITY_VERDICT",
    "AGENT_REVIEW_NE_FORMAL_HUMAN_SECURITY_REVIEW",
    "PROVIDER_CAPABILITY_EVIDENCE_NE_PROVIDER_SUPPORT",
    "CONTRACT_CANDIDATE_NE_ADOPTED_STANDARD"
  ],
  "effects": {
    "provider_supported": false,
    "formal_human_security_review_complete": false,
    "contract_adopted_as_standard": false,
    "implementation_authorized": false,
    "live_model_request_authorized": false,
    "release_authorized": false,
    "standard_ready": false
  }
}
