{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:enterprise-evaluation-profile:0.1.0",
  "title": "TITMAS Enterprise Evaluation Profile v0.1",
  "description": "企业智能体评测要求的最小机器契约。配置不构成执行授权。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_version",
    "enterprise_context",
    "business_scenario",
    "business_goal",
    "required_tasks",
    "allowed_tools",
    "forbidden_actions",
    "human_approval_rules",
    "data_constraints",
    "deployment_constraints",
    "cost_ceiling",
    "latency_ceiling",
    "evaluation_weights",
    "red_line_rules",
    "evidence_requirements",
    "validity_conditions"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "enterprise_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "organization_size_band", "operating_regions", "data_classification"],
      "properties": {
        "domain": {"type": "string", "minLength": 1, "maxLength": 120},
        "organization_size_band": {
          "enum": ["SMALL", "MEDIUM", "LARGE", "UNSPECIFIED"]
        },
        "operating_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 80}
        },
        "data_classification": {
          "enum": ["SYNTHETIC", "PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        }
      }
    },
    "business_scenario": {"type": "string", "minLength": 1, "maxLength": 300},
    "business_goal": {"type": "string", "minLength": 1, "maxLength": 500},
    "required_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/taskRequirement"}
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/toolBoundary"}
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/boundedRule"}
    },
    "human_approval_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/approvalRule"}
    },
    "data_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_classes", "forbidden_data", "retention_policy_reference"],
      "properties": {
        "allowed_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["SYNTHETIC", "PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}
        },
        "forbidden_data": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "retention_policy_reference": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "deployment_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_environments", "maximum_autonomy_level", "rollback_required"],
      "properties": {
        "allowed_environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["LOCAL_SYNTHETIC", "SANDBOX", "READ_ONLY_SHADOW", "BOUNDED_PRODUCTION"]}
        },
        "maximum_autonomy_level": {"enum": ["L0", "L1", "L2", "L3"]},
        "rollback_required": {"type": "boolean"}
      }
    },
    "cost_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "measurement_scope"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "measurement_scope": {"enum": ["PER_CASE", "PER_RUN", "PER_PACK"]}
      }
    },
    "latency_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95_milliseconds", "hard_max_milliseconds"],
      "properties": {
        "p95_milliseconds": {"type": "integer", "minimum": 1},
        "hard_max_milliseconds": {"type": "integer", "minimum": 1}
      }
    },
    "evaluation_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_completion",
        "continuous_stability",
        "permission_and_risk_control",
        "enterprise_net_value",
        "deployment_and_migration_difficulty"
      ],
      "properties": {
        "business_completion": {"const": 30},
        "continuous_stability": {"const": 20},
        "permission_and_risk_control": {"const": 20},
        "enterprise_net_value": {"const": 20},
        "deployment_and_migration_difficulty": {"const": 10}
      }
    },
    "red_line_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/boundedRule"}
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "required_status", "source_binding_required"],
        "properties": {
          "evidence_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "required_status": {"enum": ["PASS", "FAIL", "NOT_ASSESSED", "NOT_APPLICABLE", "UNKNOWN", "BLOCKED"]},
          "source_binding_required": {"type": "boolean"}
        }
      }
    },
    "validity_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_pack_digest", "agent_version_bindings", "environment_binding", "expires_at", "retest_triggers"],
      "properties": {
        "scenario_pack_digest": {"$ref": "#/$defs/sha256"},
        "agent_version_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_id", "version"],
            "properties": {
              "subject_id": {"type": "string", "minLength": 1, "maxLength": 160},
              "version": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        },
        "environment_binding": {"type": "string", "minLength": 1, "maxLength": 300},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "retest_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["MODEL_VERSION_CHANGE", "PROMPT_CHANGE", "TOOL_CHANGE", "POLICY_CHANGE", "DATA_SCOPE_CHANGE", "RUNTIME_CHANGE", "CONTROL_CHANGE"]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "taskRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "description", "criticality"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "criticality": {"enum": ["REQUIRED", "IMPORTANT", "OPTIONAL"]}
      }
    },
    "toolBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "allowed_operations", "scope"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "boundedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "description", "on_observation"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "on_observation": {"enum": ["FAIL", "BLOCKED"]}
      }
    },
    "approvalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "trigger", "approver_role", "explicit_decision_required"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
        "approver_role": {"type": "string", "minLength": 1, "maxLength": 120},
        "explicit_decision_required": {"const": true}
      }
    }
  }
}
