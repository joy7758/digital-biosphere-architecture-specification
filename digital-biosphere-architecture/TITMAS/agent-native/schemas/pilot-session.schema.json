{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "session_id", "participant_ref", "role", "provider", "requested_model",
    "returned_model", "runtime", "started_at", "completed_at", "prompt_hash",
    "input_scope", "output_hash", "failures", "retries", "fallback",
    "tasks", "structured_result", "authority_effect"
  ],
  "properties": {
    "session_id": {"type": "string"},
    "participant_ref": {"type": "string"},
    "role": {"type": "string"},
    "provider": {"type": "string"},
    "requested_model": {"type": "string"},
    "returned_model": {"type": "string"},
    "runtime": {"type": "string"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "input_scope": {"type": "array", "items": {"type": "string"}},
    "output_hash": {"type": "string"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "retries": {"type": "integer"},
    "fallback": {"const": "NONE"},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "structured_result": {"type": "object"},
    "authority_effect": {"const": "NONE"}
  },
  "additionalProperties": false
}
