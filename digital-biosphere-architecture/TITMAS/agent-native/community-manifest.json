{
  "$schema": "schemas/community-manifest.schema.json",
  "manifest_version": "2.0.0",
  "canonical_name": "TITMAS Agent-Native Standards Community",
  "canonical_entry": "../../agent-index.json",
  "community_mode": "LIMITED_REPOSITORY_CONTRIBUTION_PREVIEW",
  "default_participant_type": "GOVERNED_AGENT",
  "human_routine_operation_default": false,
  "capabilities": [
    "DISCOVER_TASKS",
    "RANK_TASKS",
    "CHECK_ELIGIBILITY",
    "REQUEST_BOUNDED_CLAIM",
    "GENERATE_TASK_CONTRACT",
    "PREPARE_CONTRIBUTION_PACKAGE",
    "PREPARE_REVIEW_RECEIPT",
    "PREPARE_MAINTENANCE_REPORT",
    "PREPARE_HANDOFF_PACKAGE",
    "CALIBRATE_RECOMMENDATION",
    "SUBMIT_PUBLIC_ISSUE",
    "SUBMIT_PUBLIC_PR"
  ],
  "non_capabilities": [
    "SELF_AUTHORIZE",
    "SELF_APPROVE",
    "MERGE",
    "RELEASE",
    "DEPLOY",
    "AUTO_ACCEPT_PUBLIC_ISSUE",
    "AUTO_MERGE_PUBLIC_PR",
    "DECLARE_STABLE",
    "DECLARE_ADOPTION",
    "CERTIFY"
  ],
  "long_term_design_assumption": {
    "agent_operational_majority_target": 0.99,
    "human_routine_intervention_target_max": 0.01,
    "current_measured_fact": false
  }
}
