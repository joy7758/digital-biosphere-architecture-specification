{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/deb-titmas-001-participant.schema.json",
  "title": "DEB-TITMAS-001 Agent Participant",
  "type": "object",
  "required": [
    "participant_id",
    "provider",
    "model",
    "runtime",
    "lineage_id",
    "role",
    "capabilities",
    "limitations",
    "lease",
    "scope",
    "issued_by",
    "expires_at",
    "revocation",
    "authority_effect"
  ],
  "properties": {
    "participant_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "EXPLORER",
        "VALUE_JUDGE",
        "ARCHITECTURE_REVIEWER",
        "CONTRIBUTOR",
        "CONFORMANCE",
        "MEMORY",
        "RECOMMENDATION",
        "EVOLUTION_OBSERVER"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "lease_id",
        "task_ids",
        "status"
      ],
      "properties": {
        "lease_id": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "PREPARED",
            "ACTIVE",
            "EXPIRED",
            "REVOKED"
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "allowed",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "revocation": {
      "type": "object",
      "required": [
        "supported",
        "status",
        "reference"
      ],
      "properties": {
        "supported": {
          "const": true
        },
        "status": {
          "enum": [
            "NOT_REVOKED",
            "REVOKED"
          ]
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}
