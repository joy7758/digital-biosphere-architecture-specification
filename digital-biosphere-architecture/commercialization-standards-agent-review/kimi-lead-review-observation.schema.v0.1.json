{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:kimi-lead-review-observation:0.1",
  "title": "TITMAS Kimi Lead Review Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "validation_id",
    "status",
    "completed_at",
    "decision_reference",
    "model",
    "provider_gateway",
    "response_reference",
    "response_sha256",
    "attempts",
    "finding",
    "stage_assessment",
    "boundary_assessment",
    "gate_effect",
    "non_effects"
  ],
  "properties": {
    "$schema": {
      "const": "./kimi-lead-review-observation.schema.v0.1.json"
    },
    "schema_version": {
      "const": "0.1"
    },
    "validation_id": {
      "const": "TITMAS-CS-KIMI-20260725-001"
    },
    "status": {
      "const": "KIMI_LEAD_ADVISORY_COMPLETED"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_reference": {
      "const": "CS-D02-PRE-02"
    },
    "model": {
      "const": "kimi-k2.6"
    },
    "provider_gateway": {
      "const": "qianfan"
    },
    "response_reference": {
      "const": "kimi-lead-review-response.v0.1.md"
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "client",
          "result",
          "content_returned"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "client": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PROVIDER_TIMEOUT_OR_NETWORK_ERROR",
              "SUCCESS"
            ]
          },
          "content_returned": {
            "type": "boolean"
          }
        }
      }
    },
    "finding": {
      "const": {
        "recommend_now": "NO",
        "worth_continuing": "CONDITIONAL",
        "highest_priority": "NORMATIVE_PROFILE_SCHEMA_PLUS_ONE_AUDITABLE_CASE",
        "human_governance_decision_required": true,
        "primary_blockers": [
          "NO_NORMATIVE_PROFILE_OR_SCHEMA",
          "NO_EXECUTED_OR_INDEPENDENT_REUSE_EVIDENCE",
          "CURRENT_IMPLEMENTATION_AND_EXECUTION_AUTHORIZATION_FALSE"
        ]
      }
    },
    "stage_assessment": {
      "const": {
        "discovery": "PUBLIC_CONCEPTUAL_MATERIAL_EXISTS",
        "comprehension": "ARCHITECTURE_BOUNDARIES_DOCUMENTED",
        "use": "NOT_PROVEN",
        "reuse": "NOT_PROVEN",
        "recommendation": "NO_FOR_CURRENT_USE"
      }
    },
    "boundary_assessment": {
      "const": {
        "evidence_equals_truth": false,
        "recommendation_equals_decision": false,
        "capability_equals_permission": false,
        "attestation_equals_certification": false,
        "dbos_equals_saee": false,
        "model_response_creates_authority": false
      }
    },
    "gate_effect": {
      "const": {
        "kimi_lead_advisory_complete": true,
        "multi_model_panel_executed": false,
        "agent_review_gate_pass": false,
        "open_web_discovery_pass": false,
        "agent_use_pass": false,
        "independent_reuse_pass": false,
        "cs_g0_pass": false,
        "market_validation_pass": false,
        "customer_adoption": false
      }
    },
    "non_effects": {
      "const": {
        "governance_decision_created": false,
        "implementation_authorized": false,
        "conformance_execution_authorized": false,
        "human_or_organization_outreach_authorized": false,
        "commercial_offer_authorized": false,
        "certification_authorized": false,
        "release_authorized": false,
        "agent_instance_created": false,
        "runtime_created": false,
        "entity_instance_created": false,
        "permission_granted": false,
        "canonical_evidence_created": false
      }
    }
  }
}
