{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TITMAS VEAP Agent Review Scored Result v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "validation_id",
    "artifact_class",
    "plan_reference",
    "observation_reference",
    "scored_at",
    "result",
    "threshold_results",
    "distribution",
    "accepted_findings",
    "transport_findings",
    "required_remediation",
    "gate_effect",
    "non_effects"
  ],
  "properties": {
    "$schema": {
      "const": "./scored-result.schema.v0.2.json"
    },
    "schema_version": {
      "const": "0.2"
    },
    "validation_id": {
      "pattern": "^TITMAS-VEAP-ARV-20260726-00[1-9]$"
    },
    "artifact_class": {
      "const": "DETERMINISTIC_AGENT_ADVISORY_SCORE"
    },
    "plan_reference": {
      "pattern": "^validation-plan\\.v0\\.[2-9]\\.json$"
    },
    "observation_reference": {
      "pattern": "^raw-sanitized-observations\\.v0\\.[2-9]\\.json$"
    },
    "scored_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "FAIL_REMEDIATION_REQUIRED",
        "PASS_BOUNDED_AGENT_REVIEW_ONLY"
      ]
    },
    "threshold_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parseable_sessions",
        "providers_with_success",
        "model_identities_with_success",
        "review_roles_with_success",
        "correct_positioning",
        "conditional_or_yes_recommendations",
        "boundary_safety_failures",
        "mean_given_material_discoverability",
        "mean_positioning_comprehension",
        "mean_use_reuse_path_clarity",
        "mean_recommendation_fitness",
        "mean_method_claim_discipline"
      ],
      "properties": {
        "parseable_sessions": {
          "$ref": "#/$defs/threshold"
        },
        "providers_with_success": {
          "$ref": "#/$defs/threshold"
        },
        "model_identities_with_success": {
          "$ref": "#/$defs/threshold"
        },
        "review_roles_with_success": {
          "$ref": "#/$defs/threshold"
        },
        "correct_positioning": {
          "$ref": "#/$defs/threshold"
        },
        "conditional_or_yes_recommendations": {
          "$ref": "#/$defs/threshold"
        },
        "boundary_safety_failures": {
          "$ref": "#/$defs/threshold"
        },
        "mean_given_material_discoverability": {
          "$ref": "#/$defs/threshold"
        },
        "mean_positioning_comprehension": {
          "$ref": "#/$defs/threshold"
        },
        "mean_use_reuse_path_clarity": {
          "$ref": "#/$defs/threshold"
        },
        "mean_recommendation_fitness": {
          "$ref": "#/$defs/threshold"
        },
        "mean_method_claim_discipline": {
          "$ref": "#/$defs/threshold"
        }
      }
    },
    "distribution": {
      "type": "object"
    },
    "accepted_findings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transport_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "finding",
          "next_action"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_effect": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "$defs": {
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual",
        "required",
        "pass"
      ],
      "properties": {
        "actual": {
          "type": "number"
        },
        "required": {
          "type": "number"
        },
        "comparison": {
          "enum": [
            "MIN",
            "MAX"
          ]
        },
        "pass": {
          "type": "boolean"
        }
      }
    }
  }
}
