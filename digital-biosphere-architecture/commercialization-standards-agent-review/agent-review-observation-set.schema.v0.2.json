{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TITMAS VEAP Agent Review Observation Set v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "validation_id",
    "artifact_class",
    "plan_reference",
    "executed_at",
    "raw_provider_envelopes_persisted",
    "sessions"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-review-observation-set.schema.v0.2.json"
    },
    "schema_version": {
      "const": "0.2"
    },
    "validation_id": {
      "pattern": "^TITMAS-VEAP-ARV-20260726-00[1-9]$"
    },
    "artifact_class": {
      "const": "SANITIZED_AGENT_ADVISORY_OBSERVATIONS"
    },
    "plan_reference": {
      "pattern": "^validation-plan\\.v0\\.[2-9]\\.json$"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_provider_envelopes_persisted": {
      "const": false
    },
    "sessions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "provider_gateway",
          "endpoint_host",
          "model",
          "reviewer_role",
          "started_at",
          "completed_at",
          "attempts",
          "request_sha256",
          "http_status",
          "transport_status",
          "provider_body_sha256",
          "provider_body_bytes",
          "content_sha256",
          "content_bytes",
          "parse_status",
          "failure_category",
          "usage",
          "result"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_gateway": {
            "enum": [
              "qianfan",
              "ark",
              "deepseek"
            ]
          },
          "endpoint_host": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_role": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "transport_status": {
            "enum": [
              "SUCCESS",
              "PROVIDER_RESPONSE_FAILURE",
              "TRANSPORT_FAILURE"
            ]
          },
          "provider_body_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider_body_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parse_status": {
            "enum": [
              "PARSED_JSON",
              "INVALID_JSON_RETAINED_NO_REPAIR",
              "NOT_PARSED"
            ]
          },
          "failure_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "./agent-review-response.schema.v0.1.json"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "parse_status": {
                  "const": "PARSED_JSON"
                }
              }
            },
            "then": {
              "properties": {
                "transport_status": {
                  "const": "SUCCESS"
                },
                "failure_category": {
                  "type": "null"
                },
                "result": {
                  "$ref": "./agent-review-response.schema.v0.1.json"
                }
              }
            },
            "else": {
              "properties": {
                "result": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
