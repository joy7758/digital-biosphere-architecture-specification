    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_only",
        "deterministic",
        "provider_network_requests_max",
        "live_model_requests_max",
        "credential_reads_max",
        "source_mutations_max",
        "external_repository_writes_max"
      ],
      "properties": {
        "offline_only": {"const": true},
        "deterministic": {"const": true},
        "provider_network_requests_max": {"const": 0},
        "live_model_requests_max": {"const": 0},
        "credential_reads_max": {"const": 0},
        "source_mutations_max": {"const": 0},
        "external_repository_writes_max": {"const": 0}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicode_form",
        "lowercase",
        "replace_non_alphanumeric_with_space",
        "collapse_whitespace",
        "trim"
      ],
      "properties": {
        "unicode_form": {"const": "NFKC"},
        "lowercase": {"const": true},
        "replace_non_alphanumeric_with_space": {"const": true},
        "collapse_whitespace": {"const": true},
        "trim": {"const": true}
      }
