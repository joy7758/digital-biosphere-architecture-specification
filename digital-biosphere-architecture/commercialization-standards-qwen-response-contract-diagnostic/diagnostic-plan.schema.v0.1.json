  "properties": {
    "$schema": {"const": "./diagnostic-plan.schema.v0.1.json"},
    "document_id": {
      "const": "TITMAS-CS-D02-PRE-58-QWEN-RESPONSE-CONTRACT-OFFLINE-DIAGNOSTIC-PLAN-0.1"
    },
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_BEFORE_EXECUTION"},
    "decision_reference": {
