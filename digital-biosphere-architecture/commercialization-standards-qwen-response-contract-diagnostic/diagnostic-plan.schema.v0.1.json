    "enum_instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "allowed_values"],
      "properties": {
        "exact_text": {
          "const": "provider_fit must be SUITABLE, CONDITIONAL, or NOT_SUITABLE."
        },
        "allowed_values": {
          "const": ["SUITABLE", "CONDITIONAL", "NOT_SUITABLE"]
        }
      }
    },
    "role_phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_session", "exact_text"],
      "properties": {
        "source_session": {"const": "QWEN37-ONBOARD-03"},
        "exact_text": {
          "const": "bounded, non-production TITMAS machine-review candidate"
        }
      }
    },
    "checks": {
      "const": [
        "PLAN_PROVIDER_FIT_ENUM_DEFINED",
        "SESSION_01_ENUM_INSTRUCTION_TRANSMITTED",
        "SESSION_02_ENUM_INSTRUCTION_TRANSMITTED",
        "SESSION_03_ENUM_INSTRUCTION_TRANSMITTED",
        "SESSION_03_OBSERVED_VALUE_IN_ENUM",
        "SESSION_03_ROLE_PHRASE_NORMALIZED_MATCH",
        "SESSION_03_BOUNDARY_VALUES_PRESERVED",
        "NO_SCHEMA_OR_HISTORY_MUTATION"
