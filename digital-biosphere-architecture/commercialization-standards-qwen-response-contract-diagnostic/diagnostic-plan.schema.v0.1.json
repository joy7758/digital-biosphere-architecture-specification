    "decision_sha256": {
      "const": "c5168a388ba7266f49b630c5ab620c30a7328e668417ce218ccf2eb1db225eb0"
    },
    "decision_commit": {
      "const": "86549cf95c0a2f0479ec7d16e14c9e9fb2830ed6"
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
