{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre58-qwen-response-contract-offline-diagnostic-plan.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "decision_sha256",
    "decision_commit",
    "inputs",
    "execution_policy",
    "normalization",
    "enum_instruction",
    "role_phrase",
    "checks",
    "classification_rule",
    "next_action_on_gap"
