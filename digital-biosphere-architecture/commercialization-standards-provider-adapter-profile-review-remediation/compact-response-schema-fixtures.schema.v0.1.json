{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:pre-21-compact-response-schema-fixtures:0.1",
  "title": "TITMAS PRE-21 Compact Response Schema Fixtures v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "response_schema_reference",
    "base_instances",
    "cases",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./compact-response-schema-fixtures.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-21-COMPACT-RESPONSE-SCHEMA-FIXTURES-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FIXTURES_DEFINED_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-21"},
    "response_schema_reference": {"const": "../architecture/schemas/provider-adapter-compact-review-response.schema.v0.1.json"},
    "base_instances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ACCEPT", "RETURN_FOR_REVISION", "REJECT"],
      "properties": {
        "ACCEPT": {"type": "object"},
        "RETURN_FOR_REVISION": {"$ref": "#/$defs/derivedBase"},
        "REJECT": {"$ref": "#/$defs/derivedBase"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "fixture_class", "base_ref", "mutations", "expected_schema_valid"],
        "properties": {
          "case_id": {"pattern": "^PCR-[0-9]{3}$"},
          "fixture_class": {"type": "string", "minLength": 8},
          "base_ref": {"enum": ["ACCEPT", "RETURN_FOR_REVISION", "REJECT"]},
          "mutations": {
            "type": "array",
            "items": {"$ref": "#/$defs/mutation"}
          },
          "expected_schema_valid": {"type": "boolean"}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtures_executed", "live_review_executed", "profile_review_completed", "profile_adopted"],
      "properties": {
        "fixtures_executed": {"const": 0},
        "live_review_executed": {"const": false},
        "profile_review_completed": {"const": false},
        "profile_adopted": {"const": false}
      }
    }
  },
  "$defs": {
    "derivedBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$base", "overrides"],
      "properties": {
        "$base": {"const": "ACCEPT"},
        "overrides": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mutation"}
        }
      }
    },
    "mutation": {
      "type": "object",
      "required": ["op", "path"],
      "properties": {
        "op": {"enum": ["SET", "REMOVE", "APPEND_COPY"]},
        "path": {"type": "string", "pattern": "^/"},
        "value": {},
        "source_path": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
