      "const": {
        "direct_json_parse_only": true,
        "response_schema_validation_required": true,
        "markdown_strip_allowed": false,
        "code_fence_strip_allowed": false,
        "json_repair_allowed": false,
        "semantic_rewrite_allowed": false
