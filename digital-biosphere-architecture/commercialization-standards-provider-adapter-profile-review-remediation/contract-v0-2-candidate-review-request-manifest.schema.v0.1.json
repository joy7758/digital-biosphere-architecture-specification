{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:contract-v0-2-candidate-review-request-manifest:0.1",
  "title": "TITMAS PRE-26 v0.2 Contract Candidate Review Request Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
