{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:contract-v0-2-candidate-review-session-result:0.1",
  "title": "TITMAS PRE-26 v0.2 Contract Candidate Review Session Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "session_id",
    "provider_path",
    "endpoint",
    "requested_model",
    "returned_model",
    "reviewer_role",
    "query_bytes",
    "query_sha256",
    "payload_bytes",
    "payload_sha256",
    "network_request_count",
    "http_status",
    "response_byte_count",
    "response_envelope_sha256",
    "direct_json_parse_pass",
    "response_schema_pass",
    "returned_model_present",
    "returned_model_equals_requested_model",
    "boundary_acknowledgements_pass",
    "terminal_failure_category",
    "qualifying",
    "review_response",
    "sanitized_errors",
    "attempt_accounting",
    "persistence_boundary",
    "effects"
  ],
  "properties": {
    "$schema": {
      "const": "./contract-v0-2-candidate-review-session-result.schema.v0.1.json"
    },
    "document_id": {
      "type": "string",
      "pattern": "^DBA-TITMAS-CS-D02-PRE-26-(KIMI|GLM)-V0-2-CONTRACT-CANDIDATE-REVIEW-SESSION-RESULT-0\\.1$"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "QUALIFYING_REVIEW_COMPLETED",
        "NON_QUALIFYING_REVIEW_COMPLETED",
        "NON_QUALIFYING_PROVIDER_FAILURE"
      ]
    },
    "decision_reference": {
      "const": "CS-D02-PRE-26"
    },
    "session_id": {
      "enum": [
        "PRE26-KIMI-V0_2-CONTRACT-REVIEW",
        "PRE26-GLM-V0_2-CONTRACT-REVIEW"
      ]
    },
    "provider_path": {
      "const": "QIANFAN_DIRECT_CHAT_COMPLETIONS"
    },
    "endpoint": {
      "const": "https://qianfan.baidubce.com/v2/chat/completions"
    },
    "requested_model": {
      "enum": [
        "kimi-k2.6",
        "glm-5.2"
      ]
    },
    "returned_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reviewer_role": {
      "enum": [
        "INTEROPERABILITY_AND_FAILURE_SEMANTICS_REVIEWER",
        "GOVERNANCE_ALIAS_AND_VERSIONING_REVIEWER"
      ]
    },
    "query_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "query_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "network_request_count": {
      "const": 1
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "response_byte_count": {
      "type": "integer",
      "minimum": 0
    },
    "response_envelope_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "direct_json_parse_pass": {
      "type": "boolean"
    },
    "response_schema_pass": {
      "type": "boolean"
    },
    "returned_model_present": {
      "type": "boolean"
    },
    "returned_model_equals_requested_model": {
      "type": "boolean"
    },
    "boundary_acknowledgements_pass": {
      "type": "boolean"
    },
    "terminal_failure_category": {
      "enum": [
        "NONE",
        "NETWORK_ERROR",
        "HTTP_NON_200",
        "PROVIDER_ENVELOPE_INVALID",
        "MESSAGE_CONTENT_MISSING",
        "DIRECT_JSON_PARSE_FAILURE",
        "RESPONSE_SCHEMA_FAILURE",
        "RETURNED_MODEL_MISSING",
        "RETURNED_MODEL_MISMATCH",
        "BOUNDARY_ACKNOWLEDGEMENT_FAILURE"
      ]
    },
    "qualifying": {
      "type": "boolean"
    },
    "review_response": {
      "type": [
        "object",
        "null"
      ]
    },
    "sanitized_errors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "attempt_accounting": {
      "const": {
        "retry_attempts": 0,
        "fallback_attempts": 0,
        "model_substitutions": 0,
        "alias_inference_attempts": 0,
        "json_repair_attempts": 0,
        "web_search_requests": 0,
        "reviewer_tool_calls": 0
      }
    },
    "persistence_boundary": {
      "const": {
        "credential_persisted": false,
        "raw_provider_envelope_persisted": false,
        "usage_persisted": false,
        "hidden_reasoning_persisted": false,
        "provider_error_body_persisted": false
      }
    },
    "effects": {
      "const": {
        "contract_candidates_adopted": false,
        "implementation_created": false,
        "provider_supported": false,
        "conformance_executed": false,
        "authority_created": false,
        "permission_created": false,
        "evidence_is_truth": false
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
