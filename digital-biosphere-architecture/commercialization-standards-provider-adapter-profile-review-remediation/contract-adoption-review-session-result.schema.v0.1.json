{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:contract-adoption-review-session-result:0.1",
  "title": "TITMAS Contract Adoption Review Session Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "observed_at",
    "decision_reference",
    "session_id",
    "provider_path",
    "requested_model",
    "returned_model",
    "query_bytes",
    "query_sha256",
    "query_binding_match",
    "request_executed",
    "transport_status",
    "tool_result_is_error",
    "http_status",
    "response_body_bytes",
    "response_body_sha256",
    "model_binding",
    "direct_json_parse_pass",
    "response_schema_pass",
    "assistant_content_bytes",
    "assistant_content_sha256",
    "review_response",
    "qualifying_review",
    "failure_class",
    "retry_attempts",
    "fallback_attempts",
    "repair_attempts",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./contract-adoption-review-session-result.schema.v0.1.json"},
    "document_id": {"type": "string", "pattern": "^DBA-TITMAS-CS-D02-PRE-24-CONTRACT-ADOPTION-REVIEW-SESSION-[A-Z-]+-0.1$"},
    "version": {"const": "0.1.0"},
    "status": {
      "enum": [
        "PROVIDER_TIMEOUT_OR_NETWORK_ERROR",
        "RESPONSE_SCHEMA_PASS_MODEL_BINDING_MISMATCH",
        "QUALIFYING_REVIEW",
        "RESPONSE_PARSE_OR_SCHEMA_FAILURE"
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "decision_reference": {"const": "CS-D02-PRE-24"},
    "session_id": {
      "enum": [
        "PRE24-KIMI-CONTRACT-REVIEW",
        "PRE24-DEEPSEEK-CONTRACT-REVIEW"
      ]
    },
    "provider_path": {
      "enum": [
        "BAIDU_QIANFAN_EXACT_MODEL_TOOL",
        "DEEPSEEK_V1_CHAT_COMPLETIONS"
      ]
    },
    "requested_model": {
      "enum": ["kimi-k2.6", "deepseek-chat"]
    },
    "returned_model": {
      "type": ["string", "null"]
    },
    "query_bytes": {"type": "integer", "minimum": 1},
    "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_binding_match": {"const": true},
    "request_executed": {"const": true},
    "transport_status": {
      "enum": ["PROVIDER_ERROR", "HTTP_200"]
    },
    "tool_result_is_error": {"type": "boolean"},
    "http_status": {"type": ["integer", "null"]},
    "response_body_bytes": {"type": ["integer", "null"], "minimum": 0},
    "response_body_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "model_binding": {
      "enum": [
        "NOT_EVALUATED_PROVIDER_FAILURE",
        "EXACT_CONNECTOR_CONTRACT",
        "EXACT_MATCH",
        "MISMATCH",
        "UNKNOWN"
      ]
    },
    "direct_json_parse_pass": {"type": "boolean"},
    "response_schema_pass": {"type": "boolean"},
    "assistant_content_bytes": {"type": ["integer", "null"], "minimum": 0},
    "assistant_content_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "review_response": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "./contract-adoption-review-response.schema.v0.1.json"}
      ]
    },
    "qualifying_review": {"type": "boolean"},
    "failure_class": {"type": ["string", "null"]},
    "retry_attempts": {"const": 0},
    "fallback_attempts": {"const": 0},
    "repair_attempts": {"const": 0},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_candidates_adopted", "implementation_created", "provider_supported", "formal_adoption_decision_ready"],
      "properties": {
        "contract_candidates_adopted": {"const": false},
        "implementation_created": {"const": false},
        "provider_supported": {"const": false},
        "formal_adoption_decision_ready": {"const": false}
      }
    }
  }
}
