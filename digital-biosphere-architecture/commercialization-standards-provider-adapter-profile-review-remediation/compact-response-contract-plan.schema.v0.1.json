{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:pre-21-compact-response-contract-plan:0.1",
  "title": "TITMAS PRE-21 Compact Response Contract Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "execution_mode",
    "input_manifest_reference",
    "limits",
    "steps",
    "success_conditions",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./compact-response-contract-plan.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-21-COMPACT-RESPONSE-CONTRACT-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-21"},
    "execution_mode": {"const": "DETERMINISTIC_OFFLINE_ONLY"},
    "input_manifest_reference": {"const": "compact-response-contract-input-manifest.v0.1.json"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_model_requests_max",
        "provider_network_requests_max",
        "compact_request_cap_bytes",
        "retry_attempts_max",
        "fallback_attempts_max",
        "repair_attempts_max"
      ],
      "properties": {
        "live_model_requests_max": {"const": 0},
        "provider_network_requests_max": {"const": 0},
        "compact_request_cap_bytes": {"const": 24000},
        "retry_attempts_max": {"const": 0},
        "fallback_attempts_max": {"const": 0},
        "repair_attempts_max": {"const": 0}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "success_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_hashes_match",
        "fixture_expectations_matched",
        "fixture_expectations_total",
        "scope_elevation_fixtures_rejected",
        "verdict_inconsistency_fixtures_rejected",
        "v0_2_request_cap_met",
        "live_model_requests_executed",
        "profile_review_completed"
      ],
      "properties": {
        "input_hashes_match": {"const": true},
        "fixture_expectations_matched": {"const": 13},
        "fixture_expectations_total": {"const": 13},
        "scope_elevation_fixtures_rejected": {"const": true},
        "verdict_inconsistency_fixtures_rejected": {"const": true},
        "v0_2_request_cap_met": {"const": true},
        "live_model_requests_executed": {"const": 0},
        "profile_review_completed": {"const": false}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_started", "live_review_executed", "profile_review_completed", "profile_adopted"],
      "properties": {
        "execution_started": {"const": false},
        "live_review_executed": {"const": false},
        "profile_review_completed": {"const": false},
        "profile_adopted": {"const": false}
      }
    }
  }
}
