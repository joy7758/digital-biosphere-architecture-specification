{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:contract-adoption-review-plan:0.1",
  "title": "TITMAS Contract Adoption Review Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "decision_reference", "execution_mode", "input_manifest_reference", "request_manifest_reference", "limits", "steps", "session_failure_policy", "success_conditions", "effects"],
  "properties": {
    "$schema": {"const": "./contract-adoption-review-plan.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-24-CONTRACT-ADOPTION-REVIEW-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-24"},
    "execution_mode": {"const": "EXACT_TWO_SESSION_READ_ONLY_AGENT_REVIEW"},
    "input_manifest_reference": {"const": "contract-adoption-review-input-manifest.v0.1.json"},
    "request_manifest_reference": {"const": "contract-adoption-review-request-manifest.v0.1.json"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_sessions_max", "kimi_k2_6_requests_max", "deepseek_chat_requests_max", "retry_attempts_max", "fallback_attempts_max", "repair_attempts_max", "web_search_requests_max", "reviewer_tool_calls_max"],
      "properties": {
        "reviewer_sessions_max": {"const": 2},
        "kimi_k2_6_requests_max": {"const": 1},
        "deepseek_chat_requests_max": {"const": 1},
        "retry_attempts_max": {"const": 0},
        "fallback_attempts_max": {"const": 0},
        "repair_attempts_max": {"const": 0},
        "web_search_requests_max": {"const": 0},
        "reviewer_tool_calls_max": {"const": 0}
      }
    },
    "steps": {
      "const": [
        "VERIFY_ALL_INPUT_HASHES",
        "META_VALIDATE_ALL_NEW_SCHEMAS",
        "EXECUTE_RESPONSE_SCHEMA_FIXTURES",
        "RECONSTRUCT_AND_VERIFY_TWO_EXACT_QUERY_BINDINGS",
        "VERIFY_DECISION_BASELINE_IS_REMOTE",
        "CREATE_AND_REMOTE_VERIFY_AUTHORIZATION_RECEIPT",
        "EXECUTE_KIMI_K2_6_REVIEW_ONCE",
        "EXECUTE_DEEPSEEK_CHAT_REVIEW_ONCE",
        "PARSE_WITHOUT_REPAIR_AND_VALIDATE_RESPONSES",
        "VERIFY_PROVIDER_AND_MODEL_BINDINGS",
        "COMPUTE_FAIL_CLOSED_COMPOSITE_RESULT",
        "RETAIN_FAILURES_UNKNOWNS_REPORT_AND_RECEIPT"
      ]
    },
    "session_failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary_session_failure_is_independent", "ordinary_session_failure_cancels_other_session", "shared_input_or_authorization_failure_stops_all", "model_mismatch_is_qualifying", "schema_failure_is_qualifying", "retry_after_failure_allowed"],
      "properties": {
        "ordinary_session_failure_is_independent": {"const": true},
        "ordinary_session_failure_cancels_other_session": {"const": false},
        "shared_input_or_authorization_failure_stops_all": {"const": true},
        "model_mismatch_is_qualifying": {"const": false},
        "schema_failure_is_qualifying": {"const": false},
        "retry_after_failure_allowed": {"const": false}
      }
    },
    "success_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hashes_match", "response_fixture_expectations_match", "query_bindings_match", "authorized_review_sessions", "executed_review_sessions", "retry_attempts", "fallback_attempts", "repair_attempts", "boundary_safety_failures", "formal_adoption_decision_ready", "contract_candidates_adopted", "implementation_created", "live_rerun_ready"],
      "properties": {
        "input_hashes_match": {"const": 15},
        "response_fixture_expectations_match": {"const": 4},
        "query_bindings_match": {"const": 2},
        "authorized_review_sessions": {"const": 2},
        "executed_review_sessions": {"const": 2},
        "retry_attempts": {"const": 0},
        "fallback_attempts": {"const": 0},
        "repair_attempts": {"const": 0},
        "boundary_safety_failures": {"const": 0},
        "formal_adoption_decision_ready": {"const": "RESULT_DEPENDENT"},
        "contract_candidates_adopted": {"const": false},
        "implementation_created": {"const": false},
        "live_rerun_ready": {"const": false}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_started", "contract_candidates_adopted", "implementation_created", "live_review_rerun_executed", "profile_review_completed", "profile_adopted"],
      "properties": {
        "execution_started": {"const": false},
        "contract_candidates_adopted": {"const": false},
        "implementation_created": {"const": false},
        "live_review_rerun_executed": {"const": false},
        "profile_review_completed": {"const": false},
        "profile_adopted": {"const": false}
      }
    }
  }
}
