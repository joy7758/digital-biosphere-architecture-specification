        "CREATE_RESPONSE_EXTRACTION_CONTRACT_CANDIDATE",
        "CREATE_MODEL_BINDING_POLICY_CANDIDATE",
        "CREATE_SYNTHETIC_EXTRACTION_AND_MODEL_FIXTURES",
        "RUN_DIRECT_EXTRACTION_FIXTURES_WITHOUT_REPAIR",
        "RUN_MODEL_BINDING_FIXTURES",
