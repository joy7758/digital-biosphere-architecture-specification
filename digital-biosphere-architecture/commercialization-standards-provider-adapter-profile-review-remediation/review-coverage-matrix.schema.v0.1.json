{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:pre-20-review-coverage-matrix:0.1",
  "title": "TITMAS PRE-20 Review Coverage Matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "projection_reference",
    "criteria_total",
    "criteria",
    "coverage_claim",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./review-coverage-matrix.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-20-REVIEW-COVERAGE-MATRIX-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "CANDIDATE_NOT_OFFLINE_VALIDATED"},
    "decision_reference": {"const": "CS-D02-PRE-20"},
    "projection_reference": {"const": "../architecture/provider-adapter-profile-review-projection.v0.1.json"},
    "criteria_total": {"const": 7},
    "criteria": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "projection_paths", "source_pointers"],
        "properties": {
          "criterion": {
            "enum": [
              "INTEROPERABILITY",
              "DEVELOPER_IMPLEMENTABILITY",
              "NORMALIZED_REQUEST_RESULT_BOUNDARY",
              "FAILURE_TAXONOMY_COMPLETENESS",
              "SEMANTIC_NON_ELEVATION",
              "PRIVACY_AND_PERSISTENCE_BOUNDARY",
              "CONFORMANCE_CASE_ADEQUACY"
            ]
          },
          "projection_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/"}
          },
          "source_pointers": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "pointer"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
                "pointer": {"type": "string", "pattern": "^/"}
              }
            }
          }
        }
      }
    },
    "coverage_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_with_source_coverage",
        "criteria_total",
        "all_projection_paths_resolve_required",
        "all_source_pointers_resolve_required",
        "full_source_equivalence_claimed"
      ],
      "properties": {
        "criteria_with_source_coverage": {"const": 7},
        "criteria_total": {"const": 7},
        "all_projection_paths_resolve_required": {"const": true},
        "all_source_pointers_resolve_required": {"const": true},
        "full_source_equivalence_claimed": {"const": false}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline_validation_completed", "review_completed", "profile_adopted"],
      "properties": {
        "offline_validation_completed": {"const": false},
        "review_completed": {"const": false},
        "profile_adopted": {"const": false}
      }
    }
  }
}
