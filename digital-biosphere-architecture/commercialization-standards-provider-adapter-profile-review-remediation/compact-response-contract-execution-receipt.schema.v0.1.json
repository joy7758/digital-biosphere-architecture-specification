{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:pre-21-compact-response-contract-execution-receipt:0.1",
  "title": "TITMAS PRE-21 Compact Response Contract Execution Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "observed_at",
    "decision_reference",
    "branch",
    "authorization",
    "artifact_bindings",
    "execution_accounting",
    "result",
    "effects"
