{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/deepseek-binding-scope-and-security-plan.schema.v0.1.json",
  "title": "DeepSeek Binding Scope and Security Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "observed_at",
    "scope",
    "frozen_inputs",
    "provider_candidate",
    "transport_candidate",
    "phase_mapping",
    "network_boundary",
    "credential_and_data_boundary",
    "candidate_limits",
    "failure_taxonomy",
    "prohibited_recovery",
    "retention",
    "rollback",
    "stop_conditions",
    "next_agent_review",
    "effects"
  ],
  "properties": {
    "$schema": { "const": "./deepseek-binding-scope-and-security-plan.schema.v0.1.json" },
    "document_id": { "const": "TITMAS-RB1-DEEPSEEK-BINDING-SCOPE-SECURITY-PLAN-0.1" },
    "version": { "const": "0.1.0" },
    "status": { "const": "PREPARED_NOT_REVIEWED" },
    "observed_at": { "const": "2026-07-27" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_repository", "target_repository", "target_branch", "target_write_paths", "provider_requests", "credential_reads"],
      "properties": {
        "primary_repository": { "const": "digital-biosphere-architecture" },
        "target_repository": { "const": "https://github.com/joy7758/titmas-integrations.git" },
        "target_branch": { "const": "codex/rb0-governance-baseline" },
        "target_write_paths": { "const": 0 },
        "provider_requests": { "const": 0 },
        "credential_reads": { "const": 0 }
      }
    },
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dba_decision_commit", "target_commit", "target_main_commit", "pre49_result", "blocker"],
      "properties": {
        "dba_decision_commit": { "$ref": "#/$defs/gitSha" },
        "target_commit": { "$ref": "#/$defs/gitSha" },
        "target_main_commit": { "$ref": "#/$defs/gitSha" },
        "pre49_result": { "const": "PASS" },
        "blocker": { "const": "B-025" }
      }
    },
    "provider_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "base_url", "method", "path", "model", "stream", "thinking_type", "response_format", "credential_identifier", "support_status"],
      "properties": {
        "candidate_id": { "const": "DEEPSEEK_OPENAI_COMPATIBLE_CHAT_COMPLETIONS" },
        "base_url": { "const": "https://api.deepseek.com" },
        "method": { "const": "POST" },
        "path": { "const": "/chat/completions" },
        "model": { "const": "deepseek-v4-pro" },
        "stream": { "const": false },
        "thinking_type": { "const": "disabled" },
        "response_format": { "const": "json_object" },
        "credential_identifier": { "const": "DEEPSEEK_API_KEY" },
        "support_status": { "const": "UNKNOWN_NOT_ADOPTED" }
      }
    },
    "transport_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "mode", "http2", "proxy", "redirect", "automatic_retry", "tls_verification", "sni_hostname", "dependency_adopted"],
      "properties": {
        "package": { "const": "httpcore" },
        "version": { "const": "1.0.9" },
        "mode": { "const": "SYNCHRONOUS_HTTP_1_1_DIRECT" },
        "http2": { "const": false },
        "proxy": { "const": false },
        "redirect": { "const": false },
        "automatic_retry": { "const": false },
        "tls_verification": { "const": true },
        "sni_hostname": { "const": "api.deepseek.com" },
        "dependency_adopted": { "const": false }
      }
    },
    "phase_mapping": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "$ref": "#/$defs/p0Phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/phase" }
      ],
      "items": false
    },
    "network_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port", "path", "allowed_methods", "redirect_allowed", "proxy_allowed", "alternate_host_allowed", "ip_literal_allowed"],
      "properties": {
        "scheme": { "const": "https" },
        "host": { "const": "api.deepseek.com" },
        "port": { "const": 443 },
        "path": { "const": "/chat/completions" },
        "allowed_methods": { "const": ["POST"] },
        "redirect_allowed": { "const": false },
        "proxy_allowed": { "const": false },
        "alternate_host_allowed": { "const": false },
        "ip_literal_allowed": { "const": false }
      }
    },
    "credential_and_data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_identifier_only", "credential_value_retention", "authorization_header_retention", "raw_request_body_retention", "raw_response_body_retention", "raw_provider_error_retention", "prompt_retention", "hidden_reasoning_retention", "environment_dump_retention", "allowed_retained_classes"],
      "properties": {
        "credential_identifier_only": { "const": "DEEPSEEK_API_KEY" },
        "credential_value_retention": { "const": false },
        "authorization_header_retention": { "const": false },
        "raw_request_body_retention": { "const": false },
        "raw_response_body_retention": { "const": false },
        "raw_provider_error_retention": { "const": false },
        "prompt_retention": { "const": false },
        "hidden_reasoning_retention": { "const": false },
        "environment_dump_retention": { "const": false },
        "allowed_retained_classes": {
          "const": ["BOUNDED_BYTE_COUNT", "APPROVED_ENUM", "SHA256_DIGEST", "SANITIZED_REFERENCE", "SANITIZED_TIMESTAMP"]
        }
      }
    },
    "candidate_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_timeout_seconds", "connect_timeout_seconds", "write_timeout_seconds", "read_timeout_seconds", "total_request_deadline_seconds", "max_serialized_request_bytes", "max_response_body_bytes", "max_output_tokens", "max_choices", "infinite_timeout_allowed"],
      "properties": {
        "pool_timeout_seconds": { "const": 5 },
        "connect_timeout_seconds": { "const": 10 },
        "write_timeout_seconds": { "const": 30 },
        "read_timeout_seconds": { "const": 60 },
        "total_request_deadline_seconds": { "const": 90 },
        "max_serialized_request_bytes": { "const": 131072 },
        "max_response_body_bytes": { "const": 1048576 },
        "max_output_tokens": { "const": 4096 },
        "max_choices": { "const": 1 },
        "infinite_timeout_allowed": { "const": false }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibited_recovery": { "$ref": "#/$defs/allFalseObject" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_failure_required", "failure_overwrite_allowed", "raw_body_retention_allowed", "planning_history_retained"],
      "properties": {
        "first_failure_required": { "const": true },
        "failure_overwrite_allowed": { "const": false },
        "raw_body_retention_allowed": { "const": false },
        "planning_history_retained": { "const": true }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_parent", "history_rewrite_allowed", "force_push_allowed", "followup_commit_only"],
      "properties": {
        "target_parent": { "$ref": "#/$defs/gitSha" },
        "history_rewrite_allowed": { "const": false },
        "force_push_allowed": { "const": false },
        "followup_commit_only": { "const": true }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_agent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sequence", "implementation_decision_allowed"],
      "properties": {
        "status": { "const": "NOT_AUTHORIZED" },
        "sequence": { "const": ["AGENT_DEVELOPER", "AGENT_RECOMMENDER_MACHINE_CUSTOMER", "INTEGRATION_MAINTAINER", "SECURITY_REVIEWER"] },
        "implementation_decision_allowed": { "const": false }
      }
    },
    "effects": {
      "type": "object",
      "minProperties": 16,
      "additionalProperties": { "const": false }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "source_event", "layer", "directly_observable", "status"],
      "properties": {
        "phase": { "pattern": "^P[0-9]$" },
        "source_event": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["TRANSPORT", "APPLICATION"] },
        "directly_observable": { "const": true },
        "status": { "const": "CANDIDATE" }
      }
    },
    "p0Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "source_event", "layer", "directly_observable", "status"],
      "properties": {
        "phase": { "const": "P0" },
        "source_event": { "const": "NO_SEPARATE_HTTPCORE_DNS_EVENT" },
        "layer": { "const": "TRANSPORT" },
        "directly_observable": { "const": false },
        "status": { "const": "BLOCKED_GAP" }
      }
    },
    "allFalseObject": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": { "const": false }
    }
  }
}
