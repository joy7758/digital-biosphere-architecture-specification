{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/deepseek-binding-negative-case-catalog.schema.v0.1.json",
  "title": "DeepSeek Binding Negative Case Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "case_count", "cases", "execution"],
  "properties": {
    "$schema": { "const": "./deepseek-binding-negative-case-catalog.schema.v0.1.json" },
    "document_id": { "const": "TITMAS-RB1-DEEPSEEK-BINDING-NEGATIVE-CASE-CATALOG-0.1" },
    "version": { "const": "0.1.0" },
    "status": { "const": "PLANNED_NOT_EXECUTED" },
    "case_count": { "const": 24 },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "group", "condition", "expected_result", "required_first_failure", "prohibited_effects"],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^NEG-(CRED|NET|PHASE|PROV|DATA|AUTH)-[0-9]{3}$"
          },
          "group": {
            "enum": [
              "CREDENTIAL_SECRET",
              "ENDPOINT_NETWORK",
              "PHASE_OBSERVABILITY",
              "PROVIDER_RESPONSE",
              "SANITIZATION_RETENTION",
              "AUTHORITY_NON_ELEVATION"
            ]
          },
          "condition": { "type": "string", "minLength": 1 },
          "expected_result": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "required_first_failure": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "prohibited_effects": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "pass_count", "fail_count", "unknown_count"],
      "properties": {
        "executed": { "const": false },
        "pass_count": { "const": 0 },
        "fail_count": { "const": 0 },
        "unknown_count": { "const": 24 }
      }
    }
  }
}
