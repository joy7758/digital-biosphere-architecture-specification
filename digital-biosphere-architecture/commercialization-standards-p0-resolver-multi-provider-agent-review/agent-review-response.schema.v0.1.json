{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre65-p0-resolver-agent-review-response.schema.v0.1.json",
  "title": "TITMAS PRE-65 P0 Resolver Agent Review Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "review_role",
    "verdict",
    "recommend_to_developer",
    "p0_separate_from_p1",
    "deadline_requirement_not_overclaimed",
    "platform_limitations_explicit",
    "raw_address_minimized",
    "continuity_testable",
    "original_hostname_tls_preserved",
    "retry_fallback_reresolution_closed",
    "provider_support_created",
    "formal_security_review_completed",
    "implementation_authorized",
    "authority_claimed",
    "blocking_findings",
    "required_changes",
    "reason"
  ],
  "properties": {
    "request_id": {
      "enum": ["PRE65-QF-INTEGRATION-01", "PRE65-QWEN-SECURITY-01"]
    },
    "review_role": {
      "enum": ["INTEGRATION_MAINTAINER_CANDIDATE", "INDEPENDENT_SECURITY_REVIEWER_CANDIDATE"]
    },
    "verdict": {
      "enum": ["READY_FOR_NEXT_RECOMMENDATION", "REVISE", "BLOCKED"]
    },
    "recommend_to_developer": { "enum": ["YES", "CONDITIONAL", "NO"] },
    "p0_separate_from_p1": { "type": "boolean" },
    "deadline_requirement_not_overclaimed": { "type": "boolean" },
    "platform_limitations_explicit": { "type": "boolean" },
    "raw_address_minimized": { "type": "boolean" },
    "continuity_testable": { "type": "boolean" },
    "original_hostname_tls_preserved": { "type": "boolean" },
    "retry_fallback_reresolution_closed": { "type": "boolean" },
    "provider_support_created": { "const": false },
    "formal_security_review_completed": { "const": false },
    "implementation_authorized": { "const": false },
    "authority_claimed": { "const": false },
    "blocking_findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "required_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1200 }
  }
}
