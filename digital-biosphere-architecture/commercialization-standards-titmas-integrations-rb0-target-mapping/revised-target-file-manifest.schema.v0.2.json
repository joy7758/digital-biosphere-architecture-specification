{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/revised-target-file-manifest.schema.v0.2.json",
  "title": "TITMAS Integrations Revised Target File Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "based_on_reference",
    "based_on_sha256",
    "target_repository",
    "target_commit",
    "stage_id",
    "recommended_gap_resolution",
    "files",
    "validation_requirements",
    "effects"
  ],
  "properties": {
    "$schema": {
      "const": "./revised-target-file-manifest.schema.v0.2.json"
    },
    "document_id": {
      "const": "DBA-TITMAS-CS-D02-PRE-37-REVISED-TARGET-FILE-MANIFEST-0.2"
    },
    "version": {
      "const": "0.2.0"
    },
    "status": {
      "const": "DEVELOPMENT_CANDIDATE_NOT_ADOPTED_NOT_APPLIED"
    },
    "decision_reference": {
      "const": "CS-D02-PRE-37"
    },
    "based_on_reference": {
      "const": "commercialization-standards-titmas-integrations-repository-baseline/required-target-file-manifest.v0.1.json"
    },
    "based_on_sha256": {
      "const": "6135526966bef14ef2d4b33ae55c7fa62266b338a086b30be86aee2f335db664"
    },
    "target_repository": {
      "const": "https://github.com/joy7758/titmas-integrations.git"
    },
    "target_commit": {
      "const": "e8eeccbf19e5e1d1f01ab9ad8796a53591a38dc8"
    },
    "stage_id": {
      "const": "RB0"
    },
    "recommended_gap_resolution": {
      "const": "A_CORRECTED_ROOT_RELATIVE_PATH"
    },
    "files": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "source_ref",
          "sha256",
          "prior_state",
          "prior_sha256",
          "content_gate"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+$"
          },
          "action": {
            "enum": [
              "CREATE",
              "UPDATE",
              "CREATE_IF_LICENSE_ADOPTED"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 20
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "prior_state": {
            "enum": [
              "ABSENT",
              "PRESENT"
            ]
          },
          "prior_sha256": {
            "oneOf": [
              {
                "const": "NOT_APPLICABLE"
              },
              {
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "content_gate": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "validation_requirements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_candidate_defined",
        "manifest_adopted",
        "license_adopted",
        "target_repository_modified",
        "repository_baseline_applied",
        "implementation_authorized",
        "implementation_created"
      ],
      "properties": {
        "manifest_candidate_defined": {
          "const": true
        },
        "manifest_adopted": {
          "const": false
        },
        "license_adopted": {
          "const": false
        },
        "target_repository_modified": {
          "const": false
        },
        "repository_baseline_applied": {
          "const": false
        },
        "implementation_authorized": {
          "const": false
        },
        "implementation_created": {
          "const": false
        }
      }
    }
  }
}
