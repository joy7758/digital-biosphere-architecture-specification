{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:titmas:schema:public-first-party-method-delta-review-plan:0.2",
  "title": "Public First-party Method Delta Review Plan v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "validation_id",
    "status",
    "frozen_at",
    "decision_reference",
    "source_digests",
    "sessions",
    "request_contract",
    "success_thresholds",
    "retry_policy",
    "data_policy",
    "maximum_effect",
    "non_effects"
  ],
  "properties": {
    "$schema": {"const": "./validation-plan.schema.v0.2.json"},
    "schema_version": {"const": "0.2"},
    "validation_id": {"const": "TITMAS-VEAP-PFPMR-20260726-002"},
    "status": {"const": "FROZEN_BEFORE_EXECUTION"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "decision_reference": {"const": "CS-D02-PRE-07"},
    "source_digests": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "sessions": {
      "type": "array",
      "const": [
        {
          "session_id": "QF-METHOD-DELTA-PFPMR-S1",
          "provider_gateway": "qianfan",
          "endpoint_host": "qianfan.baidubce.com",
          "model": "ernie-4.5-turbo-128k",
          "reviewer_role": "METHOD_DELTA_REVIEWER",
          "role_focus": "Verify that v0.2 addresses all six PRE-06 required method changes, especially complex organization independence, context-key deduplication and conflicting-report handling, without making the candidate cap effective.",
          "thinking_mode": "PROVIDER_DEFAULT"
        },
        {
          "session_id": "DS-CLAIM-PRIVACY-DELTA-PFPMR-S1",
          "provider_gateway": "deepseek",
          "endpoint_host": "api.deepseek.com",
          "model": "deepseek-v4-pro",
          "reviewer_role": "CLAIM_PRIVACY_DELTA_REVIEWER",
          "role_focus": "Verify accountable-role evidence, retention/deletion, correction/removal/withdrawal and all consent, customer, adoption, market, execution, counting and CS-G0 non-claims.",
          "thinking_mode": "DISABLED"
        }
      ]
    },
    "request_contract": {
      "type": "object",
      "const": {
        "messages": "ONE_USER_MESSAGE_FROM_FROZEN_TEMPLATE",
        "temperature": 0.1,
        "max_tokens": 2200,
        "response_format": "json_object",
        "request_timeout_ms": 120000,
        "parallel_execution": true,
        "deepseek_thinking_override": {"type": "disabled"}
      }
    },
    "success_thresholds": {
      "type": "object",
      "const": {
        "sessions_planned": 2,
        "parseable_sessions_min": 2,
        "providers_with_success_min": 2,
        "review_roles_with_success_min": 2,
        "method_problem_recognized_min": 2,
        "all_required_changes_addressed_min": 2,
        "non_reject_recommendations_min": 2,
        "boundary_safety_failures_max": 0,
        "mean_revision_completeness_min": 3.0,
        "mean_boundary_safety_min": 3.0,
        "mean_adoption_decision_usefulness_min": 2.5,
        "mean_source_discipline_min": 3.0
      }
    },
    "retry_policy": {
      "type": "object",
      "const": {
        "transport_retries_max": 1,
        "model_fallback_allowed": false,
        "invalid_json_repair_prompt_allowed": false
      }
    },
    "data_policy": {
      "type": "object",
      "const": {
        "public_safe_local_materials_only": true,
        "public_source_search_allowed": false,
        "public_source_collection_allowed": false,
        "customer_or_personal_data_allowed": false,
        "secrets_in_request_or_result_allowed": false,
        "raw_provider_envelope_persisted": false,
        "failures_and_dissent_must_be_retained": true
      }
    },
    "maximum_effect": {
      "type": "object",
      "const": {
        "method_v0_2_candidate_defined": true,
        "delta_review_complete": true,
        "method_adoption_review_ready": true,
        "method_adopted": false,
        "public_source_collection_authorized": false,
        "public_source_record_counting_authorized": false
      }
    },
    "non_effects": {
      "type": "object",
      "const": {
        "problem_validation_execution_authorized": false,
        "public_source_search_authorized": false,
        "external_outreach_authorized": false,
        "participant_enrollment_authorized": false,
        "network_processing_authorized": false,
        "data_collection_authorized": false,
        "implementation_authorized": false,
        "commercial_offer_authorized": false,
        "certification_authorized": false,
        "release_authorized": false,
        "valid_problem_record_created": false,
        "cs_g0_pass": false,
        "customer_adoption": false
      }
    }
  }
}
