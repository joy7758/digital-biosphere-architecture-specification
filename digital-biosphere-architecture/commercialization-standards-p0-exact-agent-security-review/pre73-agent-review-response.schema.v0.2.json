{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre73/pre73-agent-review-response.schema.v0.2.json",
  "title": "TITMAS PRE-73 Agent-assisted Static Security Review Response v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "review_session_id",
    "review_role",
    "target_commit",
    "source_package_sha256",
    "verdict",
    "summary",
    "question_assessments",
    "cross_cutting_findings",
    "explicit_non_claims"
  ],
  "properties": {
    "contract_version": {"const": "pre73.agent-review-response/v0.2"},
    "review_session_id": {
      "enum": [
        "PRE73-QF-SECURITY-01",
        "PRE73-QWEN-SECURITY-02"
      ]
    },
    "review_role": {
      "enum": [
        "IMPLEMENTATION_SECURITY_REVIEWER_CANDIDATE",
        "INDEPENDENT_SECURITY_REVIEWER_CANDIDATE"
      ]
    },
    "target_commit": {
      "const": "0030077f29c37145a306b72e7083345eb76b504a"
    },
    "source_package_sha256": {
      "const": "5e357eab0d23db0c79d34f7a66ddc01e0a8070314ed8b6be2cee3b34e3973813"
    },
    "verdict": {
      "enum": ["RETAIN", "REVISE", "REPLACE", "REJECT"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "question_assessments": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-001"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-002"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-003"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-004"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-005"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-006"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-007"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-008"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-009"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-010"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-011"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-012"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-013"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-014"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-015"}}}]},
        {"allOf": [{"$ref": "#/$defs/questionAssessment"}, {"properties": {"question_id": {"const": "SR-016"}}}]}
      ],
      "items": false
    },
    "cross_cutting_findings": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/finding"}
    },
    "explicit_non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_human_security_review_complete",
        "production_safe",
        "provider_supported",
        "cross_platform_supported",
        "real_network_conformant",
        "conformance_pass",
        "standard_ready",
        "release_authorized"
      ],
      "properties": {
        "formal_human_security_review_complete": {"const": false},
        "production_safe": {"const": false},
        "provider_supported": {"const": false},
        "cross_platform_supported": {"const": false},
        "real_network_conformant": {"const": false},
        "conformance_pass": {"const": false},
        "standard_ready": {"const": false},
        "release_authorized": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_session_id": {"const": "PRE73-QF-SECURITY-01"}
        },
        "required": ["review_session_id"]
      },
      "then": {
        "properties": {
          "review_role": {"const": "IMPLEMENTATION_SECURITY_REVIEWER_CANDIDATE"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_session_id": {"const": "PRE73-QWEN-SECURITY-02"}
        },
        "required": ["review_session_id"]
      },
      "then": {
        "properties": {
          "review_role": {"const": "INDEPENDENT_SECURITY_REVIEWER_CANDIDATE"}
        }
      }
    }
  ],
  "$defs": {
    "questionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "assessment",
        "severity",
        "finding",
        "affected_symbols",
        "proposed_tests",
        "limitations"
      ],
      "properties": {
        "question_id": {
          "pattern": "^SR-0(0[1-9]|1[0-6])$"
        },
        "assessment": {
          "enum": ["PASS", "CONCERN", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "severity": {
          "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "affected_symbols": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "proposed_tests": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "finding",
        "affected_symbols",
        "proposed_tests",
        "limitations"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^CF-[0-9]{3}$"
        },
        "severity": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "affected_symbols": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "proposed_tests": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  }
}
