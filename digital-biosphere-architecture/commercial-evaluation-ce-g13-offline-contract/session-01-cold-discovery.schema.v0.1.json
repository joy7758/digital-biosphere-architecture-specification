{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/ce-g13-session-01.schema.v0.1.json",
  "title": "CE-G13 S01 Cold Discovery Response",
  "allOf": [
    {"$ref": "./session-response.base.schema.v0.1.json#/$defs/common"},
    {
      "type": "object",
      "required": ["project_identified", "canonical_name", "public_positioning", "discovered_references", "discovery_chain", "website_sufficient_without_github"],
      "properties": {
        "session_id": {"const": "CE-G13-S01"},
        "role": {"const": "COLD_DISCOVERY_AGENT"},
        "project_identified": {"type": "boolean"},
        "canonical_name": {"type": "string"},
        "public_positioning": {"type": "string"},
        "discovered_references": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "discovery_chain": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "website_sufficient_without_github": {"type": "boolean"}
      }
    }
  ],
  "unevaluatedProperties": false
}
