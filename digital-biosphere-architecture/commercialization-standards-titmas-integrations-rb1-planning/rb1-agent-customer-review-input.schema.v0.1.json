{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/rb1-agent-customer-review-input.schema.v0.1.json",
  "title": "TITMAS Integrations RB1 Agent Customer Review Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "review_gate",
    "review_objective",
    "primary_question",
    "reviewer_profiles",
    "materials",
    "required_review_dimensions",
    "response_contract",
    "candidate_thresholds_not_adopted",
    "non_claims",
    "execution_boundary",
    "next_action"
  ],
  "properties": {
    "$schema": {"const": "./rb1-agent-customer-review-input.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-RB1-AGENT-CUSTOMER-REVIEW-INPUT-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_REVIEW_INPUT_NOT_AUTHORIZED_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-43"},
    "review_gate": {"const": "CS-D02-PRE-44"},
    "review_objective": {"type": "string", "minLength": 40},
    "primary_question": {"type": "string", "minLength": 80},
    "reviewer_profiles": {
      "const": ["AGENT_DEVELOPER", "RECOMMENDER_AGENT", "INTEGRATION_MAINTAINER", "SECURITY_BOUNDARY_REVIEWER"]
    },
    "materials": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "sha256", "role"],
        "properties": {
          "reference": {"type": "string", "minLength": 10},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 5}
        }
      }
    },
    "required_review_dimensions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "recommendation_values", "ordinal_values", "confidence_range", "boundary_check_fields", "hidden_reasoning_requested"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
        "recommendation_values": {"const": ["RECOMMENDED", "CONDITIONALLY_RECOMMENDED", "NOT_RECOMMENDED"]},
        "ordinal_values": {"const": ["LOW", "MEDIUM", "HIGH"]},
        "confidence_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": 0},
            "maximum": {"const": 1}
          }
        },
        "boundary_check_fields": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "hidden_reasoning_requested": {"const": false}
      }
    },
    "candidate_thresholds_not_adopted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions_max", "qualifying_sessions_min", "recommended_or_conditional_min", "would_recommend_min", "would_call_or_reuse_min", "authority_safety_failures_max", "provider_bindings"],
      "properties": {
        "sessions_max": {"const": 4},
        "qualifying_sessions_min": {"const": 3},
        "recommended_or_conditional_min": {"const": 2},
        "would_recommend_min": {"const": 2},
        "would_call_or_reuse_min": {"const": 2},
        "authority_safety_failures_max": {"const": 0},
        "provider_bindings": {"const": "NOT_DECIDED"}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_review_authorized",
        "network_requests_authorized",
        "model_requests_authorized",
        "credential_reads_authorized",
        "retry_allowed",
        "fallback_allowed",
        "model_substitution_allowed",
        "alias_inference_allowed",
        "json_repair_allowed",
        "raw_response_persistence_allowed",
        "sanitized_result_sink_required",
        "failure_retention_required"
      ],
      "properties": {
        "agent_review_authorized": {"const": false},
        "network_requests_authorized": {"const": false},
        "model_requests_authorized": {"const": false},
        "credential_reads_authorized": {"const": false},
        "retry_allowed": {"const": false},
        "fallback_allowed": {"const": false},
        "model_substitution_allowed": {"const": false},
        "alias_inference_allowed": {"const": false},
        "json_repair_allowed": {"const": false},
        "raw_response_persistence_allowed": {"const": false},
        "sanitized_result_sink_required": {"const": true},
        "failure_retention_required": {"const": true}
      }
    },
    "next_action": {"const": "FORM_EXACT_PRE44_AGENT_CUSTOMER_REVIEW_RECOMMENDATION_AND_DECISION"}
  }
}
