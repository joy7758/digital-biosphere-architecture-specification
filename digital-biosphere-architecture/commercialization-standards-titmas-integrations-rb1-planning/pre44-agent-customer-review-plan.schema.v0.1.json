{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre44-agent-customer-review-plan.schema.v0.1.json",
  "title": "TITMAS Integrations PRE-44 Agent Customer Review Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "execution_mode",
    "source_dba_commit",
    "target_repository",
    "target_branch",
    "target_head",
    "request_manifest_reference",
    "request_manifest_sha256",
    "response_schema_reference",
    "response_schema_sha256",
    "session_result_schema_reference",
    "session_result_schema_sha256",
    "validation_result_schema_reference",
    "validation_result_schema_sha256",
    "execution_receipt_schema_reference",
    "execution_receipt_schema_sha256",
    "limits",
    "thresholds_to_adopt_only_by_pre44_decision",
    "steps",
    "pass_meaning",
    "fail_meaning",
    "blocked_meaning",
    "stop_conditions",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./pre44-agent-customer-review-plan.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-PRE44-AGENT-CUSTOMER-REVIEW-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_NOT_AUTHORIZED_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-44"},
    "execution_mode": {"const": "EXACT_FOUR_SESSION_QIANFAN_DIRECT_REVIEW_WITH_SANITIZED_FAIL_CLOSED_HANDOFF"},
    "source_dba_commit": {"$ref": "#/$defs/gitsha"},
    "target_repository": {"const": "https://github.com/joy7758/titmas-integrations.git"},
    "target_branch": {"const": "codex/rb0-governance-baseline"},
    "target_head": {"$ref": "#/$defs/gitsha"},
    "request_manifest_reference": {"const": "pre44-agent-customer-review-request-manifest.v0.1.json"},
    "request_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "response_schema_reference": {"const": "pre44-agent-customer-review-response.schema.v0.1.json"},
    "response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "session_result_schema_reference": {"const": "pre44-agent-customer-review-session-result.schema.v0.1.json"},
    "session_result_schema_sha256": {"$ref": "#/$defs/sha256"},
    "validation_result_schema_reference": {"const": "pre44-agent-customer-review-validation-result.schema.v0.1.json"},
    "validation_result_schema_sha256": {"$ref": "#/$defs/sha256"},
    "execution_receipt_schema_reference": {"const": "pre44-agent-customer-review-execution-receipt.schema.v0.1.json"},
    "execution_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
    "limits": {
      "const": {
        "reviewer_sessions_max": 4,
        "kimi_k2_6_requests_max": 2,
        "glm_5_2_requests_max": 2,
        "total_provider_network_requests_max": 4,
        "credential_reads_max": 1,
        "request_timeout_ms": 90000,
        "retry_attempts_max": 0,
        "fallback_attempts_max": 0,
        "model_substitutions_max": 0,
        "alias_inference_attempts_max": 0,
        "json_repair_attempts_max": 0,
        "web_search_requests_max": 0,
        "reviewer_tool_calls_max": 0,
        "raw_provider_envelope_sinks_max": 0
      }
    },
    "thresholds_to_adopt_only_by_pre44_decision": {
      "const": {
        "qualifying_sessions_min": 3,
        "recommended_or_conditional_min": 2,
        "would_recommend_min": 2,
        "would_call_or_reuse_min": 2,
        "authority_safety_failures_max": 0
      }
    },
    "steps": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "pass_meaning": {"type": "string", "minLength": 40},
    "fail_meaning": {"type": "string", "minLength": 40},
    "blocked_meaning": {"type": "string", "minLength": 40},
    "stop_conditions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "effects": {
      "const": {
        "agent_review_authorized": false,
        "network_requests_authorized": false,
        "credential_reads_authorized": false,
        "thresholds_adopted": false,
        "rb1_implementation_authorized": false,
        "target_repository_modification_authorized": false,
        "package_created": false,
        "source_created": false,
        "tests_created": false,
        "provider_supported": false,
        "conformance_executed": false,
        "runtime_created": false,
        "release_authorized": false,
        "commercial_offer_authorized": false,
        "certification_authorized": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
