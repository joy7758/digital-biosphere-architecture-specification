{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre46-qianfan-structured-output-source-observation.schema.v0.1.json",
  "title": "TITMAS PRE-46 Qianfan Structured Output Source Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "observed_at",
    "source_authority",
    "sources",
    "exact_models_under_review",
    "exact_model_json_schema_support",
    "adoption_result",
    "request_parameter_effect",
    "network_requests_authorized_by_observation",
    "implementation_authorized",
    "known_limitations"
  ],
  "properties": {
    "$schema": {"const": "./pre46-qianfan-structured-output-source-observation.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-PRE46-QIANFAN-STRUCTURED-OUTPUT-SOURCE-OBSERVATION-0.1"},
    "version": {"const": "0.1.0"},
    "observed_at": {"type": "string", "format": "date"},
    "source_authority": {"const": "OFFICIAL_PRIMARY_SOURCE"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "observed_statement"],
        "properties": {
          "source_id": {
            "enum": [
              "QIANFAN_CHAT_COMPLETIONS_API",
              "QIANFAN_STRUCTURED_OUTPUT_GUIDE",
              "QIANFAN_TEXT_MODEL_LIST"
            ]
          },
          "url": {"type": "string", "format": "uri"},
          "observed_statement": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "exact_models_under_review": {
      "const": ["glm-5.2", "kimi-k2.6"]
    },
    "exact_model_json_schema_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glm-5.2", "kimi-k2.6"],
      "properties": {
        "glm-5.2": {"const": "UNKNOWN_NOT_LISTED_IN_OFFICIAL_STRUCTURED_OUTPUT_SUPPORT_SCOPE"},
        "kimi-k2.6": {"const": "UNKNOWN_NOT_LISTED_IN_OFFICIAL_STRUCTURED_OUTPUT_SUPPORT_SCOPE"}
      }
    },
    "adoption_result": {"const": "NOT_ADOPTED_FOR_PRE46_OR_ANY_FUTURE_REQUEST"},
    "request_parameter_effect": {"const": "NONE"},
    "network_requests_authorized_by_observation": {"const": false},
    "implementation_authorized": {"const": false},
    "known_limitations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    }
  }
}
