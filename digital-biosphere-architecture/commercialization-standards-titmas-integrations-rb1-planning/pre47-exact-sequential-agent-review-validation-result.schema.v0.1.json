{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre47-exact-sequential-agent-review-validation-result.schema.v0.1.json",
  "title": "TITMAS PRE-47 Exact Sequential Agent Review Validation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "decision_reference", "source_commit", "request_manifest_sha256", "session_results", "counts", "thresholds", "threshold_checks", "authority_safety_failures", "gate_result", "next_action", "effects"],
  "properties": {
    "$schema": {"const": "./pre47-exact-sequential-agent-review-validation-result.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-PRE47-EXACT-SEQUENTIAL-AGENT-REVIEW-VALIDATION-RESULT-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "decision_reference": {"const": "CS-D02-PRE-47"},
    "source_commit": {"$ref": "#/$defs/gitsha"},
    "request_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "session_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "reference", "sha256", "qualifying"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 4},
          "reference": {"type": "string", "minLength": 10},
          "sha256": {"$ref": "#/$defs/sha256"},
          "qualifying": {"type": "boolean"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions_authorized", "sessions_executed", "network_requests_executed", "qualifying_sessions", "recommended_or_conditional", "would_recommend", "would_reuse", "retry_attempts", "fallback_attempts", "model_substitutions", "alias_inference_attempts", "json_repair_attempts"],
      "properties": {
        "sessions_authorized": {"const": 4},
        "sessions_executed": {"const": 4},
        "network_requests_executed": {"type": "integer", "minimum": 0, "maximum": 4},
        "qualifying_sessions": {"type": "integer", "minimum": 0, "maximum": 4},
        "recommended_or_conditional": {"type": "integer", "minimum": 0, "maximum": 4},
        "would_recommend": {"type": "integer", "minimum": 0, "maximum": 4},
        "would_reuse": {"type": "integer", "minimum": 0, "maximum": 4},
        "retry_attempts": {"const": 0},
        "fallback_attempts": {"const": 0},
        "model_substitutions": {"const": 0},
        "alias_inference_attempts": {"const": 0},
        "json_repair_attempts": {"const": 0}
      }
    },
    "thresholds": {"const": {"qualifying_sessions_min": 3, "recommended_or_conditional_min": 2, "would_recommend_min": 2, "would_reuse_min": 2, "authority_safety_failures_max": 0}},
    "threshold_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualifying_sessions_pass", "recommended_or_conditional_pass", "would_recommend_pass", "would_reuse_pass", "authority_safety_pass"],
      "properties": {
        "qualifying_sessions_pass": {"type": "boolean"},
        "recommended_or_conditional_pass": {"type": "boolean"},
        "would_recommend_pass": {"type": "boolean"},
        "would_reuse_pass": {"type": "boolean"},
        "authority_safety_pass": {"type": "boolean"}
      }
    },
    "authority_safety_failures": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "gate_result": {"enum": ["PASS_AGENT_RECOMMENDATION_GATE_RB1_IMPLEMENTATION_RECOMMENDATION_MAY_BE_FORMED", "FAIL_RETURN_RB1_PLANNING_PACKET_FOR_REVISION", "BLOCKED_INSUFFICIENT_QUALIFYING_AGENT_RESPONSES"]},
    "next_action": {"enum": ["FORM_SEPARATE_RB1_IMPLEMENTATION_RECOMMENDATION", "REVISE_RB1_PLANNING_PACKET", "REVIEW_PROVIDER_FAILURES_WITHOUT_RETRY"]},
    "effects": {"const": {"agent_review_completed": true, "agent_review_is_human_customer_evidence": false, "pre44_history_changed": false, "market_adoption_created": false, "rb1_implementation_authorized": false, "target_repository_modified": false, "package_created": false, "source_created": false, "tests_created": false, "provider_supported": false, "conformance_executed": false, "runtime_created": false, "release_authorized": false, "commercial_offer_authorized": false, "certification_authorized": false}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
