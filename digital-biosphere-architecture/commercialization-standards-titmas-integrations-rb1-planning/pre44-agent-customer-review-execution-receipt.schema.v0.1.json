{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre44-agent-customer-review-execution-receipt.schema.v0.1.json",
  "title": "TITMAS Integrations PRE-44 Agent Customer Review Execution Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "recommendation_commit",
    "decision_commit",
    "request_manifest_sha256",
    "credential_reads",
    "network_requests",
    "session_result_count",
    "validation_result_reference",
    "validation_result_sha256",
    "failure_retention",
    "persistence_boundary",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./pre44-agent-customer-review-execution-receipt.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-PRE44-AGENT-CUSTOMER-REVIEW-EXECUTION-RECEIPT-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["EXECUTED_PASS", "EXECUTED_FAIL", "EXECUTED_BLOCKED"]},
    "decision_reference": {"const": "CS-D02-PRE-44"},
    "recommendation_commit": {"$ref": "#/$defs/gitsha"},
    "decision_commit": {"$ref": "#/$defs/gitsha"},
    "request_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "credential_reads": {"const": 1},
    "network_requests": {"type": "integer", "minimum": 0, "maximum": 4},
    "session_result_count": {"const": 4},
    "validation_result_reference": {"const": "pre44-agent-customer-review-validation-result.v0.1.json"},
    "validation_result_sha256": {"$ref": "#/$defs/sha256"},
    "failure_retention": {"const": true},
    "persistence_boundary": {
      "const": {
        "credential_persisted": false,
        "raw_provider_envelope_persisted": false,
        "usage_persisted": false,
        "hidden_reasoning_persisted": false,
        "provider_error_body_persisted": false
      }
    },
    "effects": {
      "const": {
        "rb1_implementation_authorized": false,
        "package_created": false,
        "source_created": false,
        "tests_created": false,
        "provider_supported": false,
        "conformance_executed": false,
        "runtime_created": false,
        "release_authorized": false,
        "commercial_offer_authorized": false,
        "certification_authorized": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
