{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre45-offline-failure-diagnostic-result.schema.v0.1.json",
  "title": "TITMAS Integrations PRE-45 Offline Failure Diagnostic Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "source_commit",
    "observations",
    "causal_attribution",
    "conservative_findings",
    "next_review_design_candidates",
    "validation",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./pre45-offline-failure-diagnostic-result.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-PRE45-OFFLINE-FAILURE-DIAGNOSTIC-RESULT-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["PASS_OFFLINE_DIAGNOSIS_NEXT_CONTRACT_RECOMMENDATION_ALLOWED", "FAIL_SOURCE_OR_BOUNDARY_MISMATCH"]},
    "decision_reference": {"const": "CS-D02-PRE-45"},
    "source_commit": {"$ref": "#/$defs/gitsha"},
    "observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "directly_observed", "confidence", "causal_claim"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 10},
          "directly_observed": {"type": "string", "minLength": 10, "maxLength": 600},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "causal_claim": {"const": "UNKNOWN_NOT_INFERRED"}
        }
      }
    },
    "causal_attribution": {
      "const": {
        "kimi_timeout_root_cause": "UNKNOWN",
        "glm_direct_json_failure_root_cause": "UNKNOWN",
        "concurrency_effect": "POSSIBLE_CONFOUND_NOT_MEASURED",
        "query_length_effect": "POSSIBLE_CONFOUND_NOT_MEASURED",
        "reviewer_profile_effect": "POSSIBLE_CONFOUND_NOT_MEASURED",
        "provider_availability": "NOT_PROVEN",
        "model_reliability": "NOT_PROVEN"
      }
    },
    "conservative_findings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20}
    },
    "next_review_design_candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "status", "reason"],
        "properties": {
          "candidate": {"type": "string", "minLength": 10},
          "status": {"const": "CANDIDATE_NOT_AUTHORIZED"},
          "reason": {"type": "string", "minLength": 20, "maxLength": 600}
        }
      }
    },
    "validation": {
      "const": {
        "input_hashes_match": 8,
        "network_requests": 0,
        "model_requests": 0,
        "credential_reads": 0,
        "raw_provider_envelopes_accessed": 0,
        "provider_error_bodies_accessed": 0,
        "pre44_history_rewritten": false,
        "target_repository_modified": false
      }
    },
    "effects": {
      "const": {
        "pre44_gate_pass_changed": false,
        "rb1_implementation_recommendation_allowed": false,
        "rb1_implementation_authorized": false,
        "package_created": false,
        "source_created": false,
        "tests_created": false,
        "provider_supported": false,
        "conformance_executed": false,
        "runtime_created": false,
        "release_authorized": false,
        "commercial_offer_authorized": false,
        "certification_authorized": false
      }
    }
  },
  "$defs": {
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
