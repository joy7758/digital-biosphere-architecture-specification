{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre47-exact-sequential-agent-review-request-manifest.schema.v0.1.json",
  "title": "TITMAS PRE-47 Exact Sequential Agent Review Request Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "decision_reference", "source_dba_commit", "endpoint", "credential_source", "credential_environment_name", "system_prompt", "system_prompt_bytes", "system_prompt_sha256", "query_template_reference", "query_template_bytes", "query_template_sha256", "query_composition_rule", "payload_serialization_contract", "payload_key_order", "stream", "temperature", "response_format_parameter_included", "response_schema_reference", "response_schema_sha256", "contract_reference", "contract_sha256", "sessions", "execution_contract", "persistence_boundary", "thresholds", "effects"],
  "properties": {
    "$schema": {"const": "./pre47-exact-sequential-agent-review-request-manifest.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-INTEGRATIONS-PRE47-EXACT-SEQUENTIAL-AGENT-REVIEW-REQUEST-MANIFEST-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"const": "FROZEN_NOT_AUTHORIZED_NOT_EXECUTED"},
    "decision_reference": {"const": "CS-D02-PRE-47"},
    "source_dba_commit": {"$ref": "#/$defs/gitsha"},
    "endpoint": {"const": "https://qianfan.baidubce.com/v2/chat/completions"},
    "credential_source": {"const": "QIANFAN_API_KEY_ENVIRONMENT_ONLY"},
    "credential_environment_name": {"const": "QIANFAN_API_KEY"},
    "system_prompt": {"type": "string", "minLength": 100, "maxLength": 400},
    "system_prompt_bytes": {"const": 228},
    "system_prompt_sha256": {"const": "89199e4a878dabdd6b7114a9f9c850acf021cb6c1ea05b5117394eafbd529fb9"},
    "query_template_reference": {"const": "pre46-compact-sequential-review-query-template.v0.2.txt"},
    "query_template_bytes": {"const": 2516},
    "query_template_sha256": {"const": "27785e540a3d9c862cf0227ebaf20af556e4ab18edbf694b5a405a79c6fef671"},
    "query_composition_rule": {"type": "string", "minLength": 40},
    "payload_serialization_contract": {"const": "UTF8_JSON_COMPACT_FIXED_KEY_ORDER_MODEL_MESSAGES_STREAM_TEMPERATURE"},
    "payload_key_order": {"const": ["model", "messages", "stream", "temperature"]},
    "stream": {"const": false},
    "temperature": {"const": 0.1},
    "response_format_parameter_included": {"const": false},
    "response_schema_reference": {"const": "pre46-compact-sequential-review-response.schema.v0.2.json"},
    "response_schema_sha256": {"const": "5558f02c2204d5f278a8b283e5548cde58167b4a2323c2c5df2e76cdf6d8820e"},
    "contract_reference": {"const": "pre46-compact-sequential-review-contract.v0.2.json"},
    "contract_sha256": {"const": "2618d19972992a9522b4e8ca0ce443dbb4c4871efeb8132f279bc8a7cc9d3e12"},
    "sessions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/kimiDeveloper"},
        {"$ref": "#/$defs/glmRecommender"},
        {"$ref": "#/$defs/kimiMaintainer"},
        {"$ref": "#/$defs/glmSecurity"}
      ],
      "items": false
    },
    "execution_contract": {"const": {"mode": "SEQUENTIAL", "parallel_requests_max": 1, "request_timeout_ms": 90000, "retry_attempts_max": 0, "fallback_attempts_max": 0, "model_substitutions_max": 0, "alias_inference_attempts_max": 0, "json_repair_attempts_max": 0}},
    "persistence_boundary": {"const": {"credential_persisted": false, "raw_provider_envelope_persisted": false, "usage_persisted": false, "hidden_reasoning_persisted": false, "provider_error_body_persisted": false, "sanitized_review_response_may_be_persisted_after_schema_pass": true, "failure_metadata_must_be_persisted": true}},
    "thresholds": {"const": {"sessions_max": 4, "qualifying_sessions_min": 3, "recommended_or_conditional_min": 2, "would_recommend_min": 2, "would_reuse_min": 2, "authority_safety_failures_max": 0}},
    "effects": {"const": {"requests_executed": 0, "credential_reads": 0, "pre44_gate_changed": false, "rb1_implementation_authorized": false, "target_repository_modified": false}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sessionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "session_id", "requested_model", "reviewer_profile", "query_bytes", "query_sha256", "payload_bytes", "payload_sha256", "requests_max"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 4},
        "session_id": {"type": "string"},
        "requested_model": {"enum": ["kimi-k2.6", "glm-5.2"]},
        "reviewer_profile": {"enum": ["AGENT_DEVELOPER", "RECOMMENDER_AGENT", "INTEGRATION_MAINTAINER", "SECURITY_BOUNDARY_REVIEWER"]},
        "query_bytes": {"type": "integer", "minimum": 1},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "payload_bytes": {"type": "integer", "minimum": 1},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "requests_max": {"const": 1}
      }
    },
    "kimiDeveloper": {"allOf": [{"$ref": "#/$defs/sessionBase"}, {"properties": {"sequence": {"const": 1}, "session_id": {"const": "PRE47-KIMI-AGENT-DEVELOPER"}, "requested_model": {"const": "kimi-k2.6"}, "reviewer_profile": {"const": "AGENT_DEVELOPER"}}}]},
    "glmRecommender": {"allOf": [{"$ref": "#/$defs/sessionBase"}, {"properties": {"sequence": {"const": 2}, "session_id": {"const": "PRE47-GLM-RECOMMENDER-AGENT"}, "requested_model": {"const": "glm-5.2"}, "reviewer_profile": {"const": "RECOMMENDER_AGENT"}}}]},
    "kimiMaintainer": {"allOf": [{"$ref": "#/$defs/sessionBase"}, {"properties": {"sequence": {"const": 3}, "session_id": {"const": "PRE47-KIMI-INTEGRATION-MAINTAINER"}, "requested_model": {"const": "kimi-k2.6"}, "reviewer_profile": {"const": "INTEGRATION_MAINTAINER"}}}]},
    "glmSecurity": {"allOf": [{"$ref": "#/$defs/sessionBase"}, {"properties": {"sequence": {"const": 4}, "session_id": {"const": "PRE47-GLM-SECURITY-BOUNDARY-REVIEWER"}, "requested_model": {"const": "glm-5.2"}, "reviewer_profile": {"const": "SECURITY_BOUNDARY_REVIEWER"}}}]}
  }
}
