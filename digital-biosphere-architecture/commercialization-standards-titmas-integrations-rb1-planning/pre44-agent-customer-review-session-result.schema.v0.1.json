{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre44-agent-customer-review-session-result.schema.v0.1.json",
  "title": "TITMAS Integrations PRE-44 Agent Customer Review Session Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "session_id",
    "provider_path",
    "endpoint",
    "requested_model",
    "returned_model",
    "reviewer_profile",
    "query_bytes",
    "query_sha256",
    "payload_bytes",
    "payload_sha256",
    "network_request_count",
    "http_status",
    "response_byte_count",
    "response_envelope_sha256",
    "direct_json_parse_pass",
    "response_schema_pass",
    "returned_model_present",
    "returned_model_equals_requested_model",
    "boundary_checks_pass",
    "terminal_failure_category",
    "qualifying",
    "review_response",
    "sanitized_errors",
    "attempt_accounting",
    "persistence_boundary",
    "effects"
  ],
  "properties": {
    "$schema": {"const": "./pre44-agent-customer-review-session-result.schema.v0.1.json"},
    "document_id": {
      "type": "string",
      "pattern": "^DBA-TITMAS-INTEGRATIONS-PRE44-[A-Z0-9_-]+-SESSION-RESULT-0\\.1$"
    },
    "version": {"const": "0.1.0"},
    "status": {
      "enum": [
        "QUALIFYING_REVIEW_COMPLETED",
        "NON_QUALIFYING_REVIEW_COMPLETED",
        "NON_QUALIFYING_PROVIDER_FAILURE"
      ]
    },
    "decision_reference": {"const": "CS-D02-PRE-44"},
    "session_id": {"type": "string", "pattern": "^PRE44-(KIMI|GLM)-"},
    "provider_path": {"const": "QIANFAN_DIRECT_CHAT_COMPLETIONS"},
    "endpoint": {"const": "https://qianfan.baidubce.com/v2/chat/completions"},
    "requested_model": {"enum": ["kimi-k2.6", "glm-5.2"]},
    "returned_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "reviewer_profile": {
      "enum": [
        "AGENT_DEVELOPER",
        "RECOMMENDER_AGENT",
        "INTEGRATION_MAINTAINER",
        "SECURITY_BOUNDARY_REVIEWER"
      ]
    },
    "query_bytes": {"type": "integer", "minimum": 1},
    "query_sha256": {"$ref": "#/$defs/sha256"},
    "payload_bytes": {"type": "integer", "minimum": 1},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "network_request_count": {"const": 1},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "response_byte_count": {"type": "integer", "minimum": 0},
    "response_envelope_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "direct_json_parse_pass": {"type": "boolean"},
    "response_schema_pass": {"type": "boolean"},
    "returned_model_present": {"type": "boolean"},
    "returned_model_equals_requested_model": {"type": "boolean"},
    "boundary_checks_pass": {"type": "boolean"},
    "terminal_failure_category": {
      "enum": [
        "NONE",
        "NETWORK_ERROR",
        "HTTP_NON_200",
        "PROVIDER_ENVELOPE_INVALID",
        "MESSAGE_CONTENT_MISSING",
        "DIRECT_JSON_PARSE_FAILURE",
        "RESPONSE_SCHEMA_FAILURE",
        "RETURNED_MODEL_MISSING",
        "RETURNED_MODEL_MISMATCH",
        "BOUNDARY_CHECK_FAILURE"
      ]
    },
    "qualifying": {"type": "boolean"},
    "review_response": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "pre44-agent-customer-review-response.schema.v0.1.json"}
      ]
    },
    "sanitized_errors": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "attempt_accounting": {
      "const": {
        "retry_attempts": 0,
        "fallback_attempts": 0,
        "model_substitutions": 0,
        "alias_inference_attempts": 0,
        "json_repair_attempts": 0,
        "web_search_requests": 0,
        "reviewer_tool_calls": 0
      }
    },
    "persistence_boundary": {
      "const": {
        "credential_persisted": false,
        "raw_provider_envelope_persisted": false,
        "usage_persisted": false,
        "hidden_reasoning_persisted": false,
        "provider_error_body_persisted": false
      }
    },
    "effects": {
      "const": {
        "rb1_implementation_authorized": false,
        "package_created": false,
        "source_created": false,
        "tests_created": false,
        "provider_supported": false,
        "conformance_executed": false,
        "authority_created": false,
        "permission_created": false,
        "evidence_is_truth": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
