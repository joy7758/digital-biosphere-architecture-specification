{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://titmas.cn/schemas/offline-validation-execution-receipt.schema.v0.1.json",
  "title":"TITMAS PRE-30 Offline Validation Execution Receipt",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","document_id","version","status","observed_at","decision_reference",
    "authorization_receipt_reference","authorization_receipt_sha256",
    "validation_result_reference","validation_result_sha256","accounting","effects"
  ],
  "properties":{
    "$schema":{"const":"./offline-validation-execution-receipt.schema.v0.1.json"},
    "document_id":{"const":"DBA-TITMAS-CS-D02-PRE-30-OFFLINE-VALIDATION-EXECUTION-RECEIPT-0.1"},
    "version":{"const":"0.1.0"},
    "status":{"enum":["EXECUTED_PASS_OFFLINE_CONTRACT_AND_FIXTURES","EXECUTED_FAIL_CLOSED_OFFLINE_VALIDATION"]},
    "observed_at":{"type":"string","format":"date-time"},
    "decision_reference":{"const":"CS-D02-PRE-30"},
    "authorization_receipt_reference":{"const":"offline-validation-authorization-receipt.v0.1.json"},
    "authorization_receipt_sha256":{"pattern":"^[0-9a-f]{64}$"},
    "validation_result_reference":{"const":"offline-validation-result.v0.1.json"},
    "validation_result_sha256":{"pattern":"^[0-9a-f]{64}$"},
    "accounting":{
      "type":"object","additionalProperties":false,
      "required":[
        "synthetic_fixtures_validated","expected_outcomes_match","boundary_failures",
        "network_probes_executed","http_requests_executed","provider_api_requests_executed",
        "live_model_requests_executed","credential_reads_executed"
      ],
      "properties":{
        "synthetic_fixtures_validated":{"type":"integer","minimum":0,"maximum":12},
        "expected_outcomes_match":{"type":"integer","minimum":0,"maximum":12},
        "boundary_failures":{"type":"integer","minimum":0},
        "network_probes_executed":{"const":0},
        "http_requests_executed":{"const":0},
        "provider_api_requests_executed":{"const":0},
        "live_model_requests_executed":{"const":0},
        "credential_reads_executed":{"const":0}
      }
    },
    "effects":{
      "type":"object","additionalProperties":false,
      "required":[
        "contract_candidate_ready_for_adoption_review","contract_candidate_adopted",
        "implementation_created","provider_supported","conformance_executed",
        "model_retry_authorized","valid_problem_records","cs_g0_pass",
        "commercial_offer_authorized","certification_authorized","release_authorized"
      ],
      "properties":{
        "contract_candidate_ready_for_adoption_review":{"type":"boolean"},
        "contract_candidate_adopted":{"const":false},
        "implementation_created":{"const":false},
        "provider_supported":{"const":false},
        "conformance_executed":{"const":false},
        "model_retry_authorized":{"const":false},
        "valid_problem_records":{"const":0},
        "cs_g0_pass":{"const":false},
        "commercial_offer_authorized":{"const":false},
        "certification_authorized":{"const":false},
        "release_authorized":{"const":false}
      }
    }
  }
}
