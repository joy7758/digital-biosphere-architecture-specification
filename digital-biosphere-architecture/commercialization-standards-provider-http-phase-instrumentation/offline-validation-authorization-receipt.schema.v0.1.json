{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://titmas.cn/schemas/offline-validation-authorization-receipt.schema.v0.1.json",
  "title":"TITMAS PRE-30 Offline Validation Authorization Receipt",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "$schema","document_id","version","status","observed_at","decision_reference",
    "decision_commit","decision_sha256","recommendation_reference","recommendation_commit",
    "recommendation_sha256","source_bindings","frozen_artifact_bindings",
    "pre_execution_accounting","effects"
  ],
  "properties":{
    "$schema":{"const":"./offline-validation-authorization-receipt.schema.v0.1.json"},
    "document_id":{"const":"DBA-TITMAS-CS-D02-PRE-30-OFFLINE-VALIDATION-AUTHORIZATION-RECEIPT-0.1"},
    "version":{"const":"0.1.0"},
    "status":{"const":"AUTHORIZED_NOT_EXECUTED"},
    "observed_at":{"type":"string","format":"date-time"},
    "decision_reference":{"const":"CS-D02-PRE-30"},
    "decision_commit":{"pattern":"^[0-9a-f]{40}$"},
    "decision_sha256":{"pattern":"^[0-9a-f]{64}$"},
    "recommendation_reference":{"const":"TITMAS-CS-D02-PRE-30-HTTP-PHASE-INSTRUMENTATION-CONTRACT-RECOMMENDATION-v0.1.md"},
    "recommendation_commit":{"const":"bb4c82a1a4b1dd4ded51cf62ff8a6c64e4b76840"},
    "recommendation_sha256":{"const":"8a225d2ad70573e5e12dd0df9d4fb0df9d0534d356c5fd02187ae22fd197babc"},
    "source_bindings":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/binding"}},
    "frozen_artifact_bindings":{"type":"array","minItems":8,"items":{"$ref":"#/$defs/binding"}},
    "pre_execution_accounting":{
      "const":{
        "network_probes_executed":0,"http_requests_executed":0,
        "provider_api_requests_executed":0,"live_model_requests_executed":0,
        "credential_reads_executed":0
      }
    },
    "effects":{
      "const":{
        "model_retry_authorized":false,"contract_candidate_adopted":false,
        "implementation_created":false,"provider_supported":false,
        "valid_problem_records":0,"cs_g0_pass":false,"commercial_offer_authorized":false,
        "certification_authorized":false,"release_authorized":false
      }
    }
  },
  "$defs":{
    "binding":{
      "type":"object","additionalProperties":false,"required":["reference","sha256"],
      "properties":{"reference":{"type":"string","minLength":5},"sha256":{"pattern":"^[0-9a-f]{64}$"}}
    }
  }
}
