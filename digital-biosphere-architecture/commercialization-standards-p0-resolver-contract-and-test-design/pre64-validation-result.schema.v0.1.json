{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre64-validation-result.schema.v0.1.json",
  "title": "TITMAS PRE-64 Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "decision_reference",
    "checks",
    "counts",
    "effects",
    "next_action"
  ],
  "properties": {
    "$schema": { "const": "./pre64-validation-result.schema.v0.1.json" },
    "document_id": { "const": "TITMAS-PRE64-VALIDATION-RESULT-0.1" },
    "version": { "const": "0.1.0" },
    "status": { "const": "PASS_OFFLINE_P0_RESOLVER_CONTRACT_AND_TEST_DESIGN" },
    "decision_reference": { "const": "CS-D02-PRE-64" },
    "checks": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9_]+_PASS$" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks_passed",
        "checks_total",
        "positive_design_cases",
        "negative_design_cases",
        "mutations_rejected",
        "network_requests",
        "model_requests",
        "credential_reads",
        "target_writes",
        "dependency_installs",
        "implementation_writes"
      ],
      "properties": {
        "checks_passed": { "const": 22 },
        "checks_total": { "const": 22 },
        "positive_design_cases": { "const": 6 },
        "negative_design_cases": { "const": 24 },
        "mutations_rejected": { "const": 12 },
        "network_requests": { "const": 0 },
        "model_requests": { "const": 0 },
        "credential_reads": { "const": 0 },
        "target_writes": { "const": 0 },
        "dependency_installs": { "const": 0 },
        "implementation_writes": { "const": 0 }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_adopted",
        "tests_implemented",
        "tests_executed",
        "p0_resolver_implemented",
        "formal_human_security_review_complete",
        "provider_supported",
        "implementation_authorized",
        "standard_ready"
      ],
      "properties": {
        "contract_adopted": { "const": false },
        "tests_implemented": { "const": false },
        "tests_executed": { "const": false },
        "p0_resolver_implemented": { "const": false },
        "formal_human_security_review_complete": { "const": false },
        "provider_supported": { "const": false },
        "implementation_authorized": { "const": false },
        "standard_ready": { "const": false }
      }
    },
    "next_action": {
      "const": "FORM_PRE65_P0_RESOLVER_CONTRACT_MULTI_PROVIDER_AGENT_REVIEW_RECOMMENDATION"
    }
  }
}
