{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/source-candidate-set.schema.v0.1.json",
  "title": "TITMAS Public First-party Source Candidate Set v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "decision_reference", "plan_reference", "executed_at", "execution_metrics", "candidates", "failures", "boundary_audit", "non_effects"],
  "properties": {
    "$schema": {"const": "./source-candidate-set.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-09-SOURCE-CANDIDATE-SET-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["EXECUTED_CANDIDATES_UNREVIEWED", "EXECUTED_ZERO_CANDIDATES", "EXECUTION_FAILED_CLOSED"]},
    "decision_reference": {"const": "CS-D02-PRE-09"},
    "plan_reference": {"const": "desk-research-execution-plan.v0.1.json"},
    "executed_at": {"type": "string", "format": "date-time"},
    "execution_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "queries_executed", "public_pages_opened", "candidate_records_created", "cap_violations"],
      "properties": {
        "runs": {"const": 1},
        "queries_executed": {"type": "integer", "minimum": 0, "maximum": 8},
        "public_pages_opened": {"type": "integer", "minimum": 0, "maximum": 12},
        "candidate_records_created": {"type": "integer", "minimum": 0, "maximum": 4},
        "cap_violations": {"const": 0}
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "./public-first-party-problem-candidate.schema.v0.1.json"}
    },
    "failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "boundary_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowlist_violations", "authentication_attempts", "access_control_bypass_attempts", "raw_content_persisted", "direct_personal_identifiers_persisted", "automatic_valid_statuses", "automatic_counting_events"],
      "properties": {
        "allowlist_violations": {"const": 0},
        "authentication_attempts": {"const": 0},
        "access_control_bypass_attempts": {"const": 0},
        "raw_content_persisted": {"const": 0},
        "direct_personal_identifiers_persisted": {"const": 0},
        "automatic_valid_statuses": {"const": 0},
        "automatic_counting_events": {"const": 0}
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_problem_records", "cs_g0_pass", "market_validation_pass", "customer_adoption", "implementation_authorized", "commercial_offer_authorized", "certification_authorized", "release_authorized"],
      "properties": {
        "valid_problem_records": {"const": 0},
        "cs_g0_pass": {"const": false},
        "market_validation_pass": {"const": false},
        "customer_adoption": {"const": false},
        "implementation_authorized": {"const": false},
        "commercial_offer_authorized": {"const": false},
        "certification_authorized": {"const": false},
        "release_authorized": {"const": false}
      }
    }
  }
}
