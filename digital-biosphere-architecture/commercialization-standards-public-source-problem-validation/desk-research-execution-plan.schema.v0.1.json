{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/desk-research-execution-plan.schema.v0.1.json",
  "title": "TITMAS Public First-party Desk Research Execution Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "document_id", "version", "status", "decision_reference", "decision_record_reference", "method_adoption_reference", "frozen_at", "queries", "allowed_surfaces", "eligible_source_classes", "limits", "candidate_statuses_allowed", "candidate_status_valid_allowed", "output_contracts", "execution_gate", "non_effects"],
  "properties": {
    "$schema": {"const": "./desk-research-execution-plan.schema.v0.1.json"},
    "document_id": {"const": "DBA-TITMAS-CS-D02-PRE-09-DESK-RESEARCH-EXECUTION-PLAN-0.1"},
    "version": {"const": "0.1.0"},
    "status": {"enum": ["FROZEN_AUTHORIZATION_BASELINE_NOT_EXECUTED", "EXECUTED_WITHIN_BOUNDED_SCOPE", "EXECUTION_FAILED_CLOSED"]},
    "decision_reference": {"const": "CS-D02-PRE-09"},
    "decision_record_reference": {"const": "../TITMAS-CS-D02-PRE-09-PUBLIC-FIRST-PARTY-DESK-RESEARCH-DECISION-RECORD.v0.1.json"},
    "method_adoption_reference": {"const": "../architecture/veap-public-first-party-problem-report-method-adoption.v0.2.json"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "queries": {
      "const": [
        "site:github.com/open-telemetry GenAI agent issue trace observability",
        "site:github.com/microsoft/autogen issue agent reliability execution trace",
        "site:github.com/microsoft/agent-framework issue telemetry agent execution",
        "site:github.com/langchain-ai/langchain issue agent trace reliability",
        "site:github.com/crewAIInc/crewAI issue agent execution trace reliability",
        "site:github.com/modelcontextprotocol issue audit provenance execution",
        "site:opentelemetry.io GenAI agent observability limitations",
        "site:blog.langchain.com agent incident reliability trace"
      ]
    },
    "allowed_surfaces": {
      "const": [
        "github.com/open-telemetry/",
        "github.com/microsoft/autogen",
        "github.com/microsoft/agent-framework",
        "github.com/langchain-ai/",
        "github.com/crewAIInc/",
        "github.com/modelcontextprotocol/",
        "opentelemetry.io/",
        "microsoft.github.io/",
        "learn.microsoft.com/",
        "blog.langchain.com/",
        "docs.langchain.com/",
        "crewai.com/",
        "modelcontextprotocol.io/"
      ]
    },
    "eligible_source_classes": {
      "const": ["OFFICIAL_MAINTAINER_ISSUE", "OFFICIAL_INCIDENT_REPORT", "OFFICIAL_PROJECT_POSTMORTEM", "ACCOUNTABLE_ORGANIZATION_TECHNICAL_REPORT"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_max", "queries_max", "public_pages_opened_max", "candidate_records_max", "source_time_window_start", "source_time_window_end", "quoted_words_per_source_max", "temporary_excerpt_retention_max_days", "anonymous_public_read_only", "raw_source_content_storage_allowed", "direct_personal_identifier_storage_allowed"],
      "properties": {
        "runs_max": {"const": 1},
        "queries_max": {"const": 8},
        "public_pages_opened_max": {"const": 12},
        "candidate_records_max": {"const": 4},
        "source_time_window_start": {"const": "2025-01-01T00:00:00Z"},
        "source_time_window_end": {"const": "2026-07-26T23:59:59Z"},
        "quoted_words_per_source_max": {"const": 25},
        "temporary_excerpt_retention_max_days": {"const": 0},
        "anonymous_public_read_only": {"const": true},
        "raw_source_content_storage_allowed": {"const": false},
        "direct_personal_identifier_storage_allowed": {"const": false}
      }
    },
    "candidate_statuses_allowed": {"const": ["CANDIDATE_UNREVIEWED", "PARTIAL", "INVALID", "CONFLICTED", "INVALID_AUTHORIZATION_ENVELOPE"]},
    "candidate_status_valid_allowed": {"const": false},
    "output_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_set_reference", "candidate_set_schema_reference", "candidate_schema_reference", "result_report_reference"],
      "properties": {
        "candidate_set_reference": {"const": "source-candidate-set.v0.1.json"},
        "candidate_set_schema_reference": {"const": "source-candidate-set.schema.v0.1.json"},
        "candidate_schema_reference": {"const": "public-first-party-problem-candidate.schema.v0.1.json"},
        "result_report_reference": {"const": "DESK-RESEARCH-RESULT-v0.1.md"}
      }
    },
    "execution_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_baseline_committed", "authorization_baseline_pushed", "execution_started"],
      "properties": {
        "authorization_baseline_committed": {"type": "boolean"},
        "authorization_baseline_pushed": {"type": "boolean"},
        "execution_started": {"type": "boolean"}
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_source_record_counting_authorized", "valid_problem_records", "cs_g0_pass", "market_validation_pass", "customer_adoption", "implementation_authorized", "commercial_offer_authorized", "certification_authorized", "release_authorized"],
      "properties": {
        "public_source_record_counting_authorized": {"const": false},
        "valid_problem_records": {"const": 0},
        "cs_g0_pass": {"const": false},
        "market_validation_pass": {"const": false},
        "customer_adoption": {"const": false},
        "implementation_authorized": {"const": false},
        "commercial_offer_authorized": {"const": false},
        "certification_authorized": {"const": false},
        "release_authorized": {"const": false}
      }
    }
  }
}
