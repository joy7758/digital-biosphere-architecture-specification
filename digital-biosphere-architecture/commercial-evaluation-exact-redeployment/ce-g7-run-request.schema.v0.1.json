{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/titmas-ce-g7-run-request.schema.v0.1.json",
  "title": "TITMAS CE-G7 Exact Post-switch Run Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "request_id",
    "version",
    "status",
    "decision_reference",
    "run_id",
    "created_at",
    "public_origin",
    "hash_baseline_reference",
    "active_release_expected",
    "deployment_state_expected",
    "immediate_gates_passed",
    "rounds",
    "routes",
    "requests_per_vantage",
    "total_public_origin_get_cap",
    "round_gap_seconds",
    "sequential_within_vantage",
    "retry",
    "fallback",
    "tls_verification_bypass",
    "rollback_on_any_failure",
    "effects"
