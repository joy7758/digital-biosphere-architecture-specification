{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre61-multi-provider-security-review-preflight-execution-receipt.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "status",
    "completed_at",
    "artifact_count_bound",
    "artifacts",
    "validation_counts",
    "execution_counts",
    "effects",
    "next_action"
  ],
  "properties": {
    "$schema": {"const": "./execution-receipt.schema.v0.1.json"},
    "document_id": {
      "const": "TITMAS-CS-D02-PRE-61-MULTI-PROVIDER-SECURITY-REVIEW-PREFLIGHT-EXECUTION-RECEIPT-0.1"
    },
    "version": {"const": "0.1.0"},
    "status": {"const": "PASS_20_OF_20_OFFLINE_PREFLIGHT_DESIGN"},
    "completed_at": {"type": "string", "format": "date-time"},
    "artifact_count_bound": {"const": 10},
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "validation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed", "input_hashes_matched", "provider_paths_distinct"],
      "properties": {
        "required": {"const": 20},
        "passed": {"const": 20},
        "failed": {"const": 0},
        "input_hashes_matched": {"const": 7},
        "provider_paths_distinct": {"const": 3}
      }
    },
    "execution_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_requests",
        "live_model_requests",
        "credential_reads",
        "external_repository_writes",
        "implementation_writes"
      ],
      "properties": {
        "network_requests": {"const": 0},
        "live_model_requests": {"const": 0},
        "credential_reads": {"const": 0},
        "external_repository_writes": {"const": 0},
        "implementation_writes": {"const": 0}
      }
    },
    "effects": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": {"const": false}
    },
    "next_action": {
      "const": "FORM_EXACT_LIVE_MULTI_PROVIDER_SECURITY_REVIEW_RECOMMENDATION"
    }
  }
}
