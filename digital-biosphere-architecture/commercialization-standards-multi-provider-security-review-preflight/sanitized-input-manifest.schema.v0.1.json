{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/pre61-sanitized-input-manifest.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document_id",
    "version",
    "classification",
    "references",
    "prohibited_content",
    "content_checks"
  ],
  "properties": {
    "$schema": {"const": "./sanitized-input-manifest.schema.v0.1.json"},
    "document_id": {
      "const": "TITMAS-CS-D02-PRE-61-SANITIZED-INPUT-MANIFEST-0.1"
    },
    "version": {"const": "0.1.0"},
    "classification": {"const": "PUBLIC_SAFE_REFERENCE_ONLY"},
    "references": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "path", "sha256", "content_class"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_class": {
            "enum": [
              "PUBLIC_REPOSITORY_DOCUMENT",
              "PUBLIC_SANITIZED_PROVIDER_RESULT",
              "PUBLIC_HASH_RECEIPT"
            ]
          }
        }
      }
    },
    "prohibited_content": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "content_checks": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"const": false}
    }
  }
}
